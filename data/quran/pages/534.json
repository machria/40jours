[{"id":4969,"surah":55,"ayah":68,"text":"فِيهِمَا فَٰكِهَةٌۭ وَنَخْلٌۭ وَرُمَّانٌۭ","translation":"Ils contiennent des fruits, des palmiers, et des grenadiers.","juz":27,"page":534,"surahName":"Ar-Rahmaan","surahNameAr":"سُورَةُ الرَّحۡمَٰن"},{"id":4970,"surah":55,"ayah":69,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","translation":"Lequel donc des bienfaits de votre Seigneur nierez-vous?","juz":27,"page":534,"surahName":"Ar-Rahmaan","surahNameAr":"سُورَةُ الرَّحۡمَٰن"},{"id":4971,"surah":55,"ayah":70,"text":"فِيهِنَّ خَيْرَٰتٌ حِسَانٌۭ","translation":"Là, il y aura des vertueuses et des belles.","juz":27,"page":534,"surahName":"Ar-Rahmaan","surahNameAr":"سُورَةُ الرَّحۡمَٰن"},{"id":4972,"surah":55,"ayah":71,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","translation":"Lequel donc des bienfaits de votre Seigneur nierez-vous?","juz":27,"page":534,"surahName":"Ar-Rahmaan","surahNameAr":"سُورَةُ الرَّحۡمَٰن"},{"id":4973,"surah":55,"ayah":72,"text":"حُورٌۭ مَّقْصُورَٰتٌۭ فِى ٱلْخِيَامِ","translation":"Des houris cloîtrées dans les tentes,","juz":27,"page":534,"surahName":"Ar-Rahmaan","surahNameAr":"سُورَةُ الرَّحۡمَٰن"},{"id":4974,"surah":55,"ayah":73,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","translation":"Lequel donc des bienfaits de votre Seigneur nierez-vous?","juz":27,"page":534,"surahName":"Ar-Rahmaan","surahNameAr":"سُورَةُ الرَّحۡمَٰن"},{"id":4975,"surah":55,"ayah":74,"text":"لَمْ يَطْمِثْهُنَّ إِنسٌۭ قَبْلَهُمْ وَلَا جَآنٌّۭ","translation":"qu'avant eux aucun homme ou djinn n'a déflorées.","juz":27,"page":534,"surahName":"Ar-Rahmaan","surahNameAr":"سُورَةُ الرَّحۡمَٰن"},{"id":4976,"surah":55,"ayah":75,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","translation":"Lequel donc des bienfaits de votre Seigneur nierez-vous?","juz":27,"page":534,"surahName":"Ar-Rahmaan","surahNameAr":"سُورَةُ الرَّحۡمَٰن"},{"id":4977,"surah":55,"ayah":76,"text":"مُتَّكِـِٔينَ عَلَىٰ رَفْرَفٍ خُضْرٍۢ وَعَبْقَرِىٍّ حِسَانٍۢ","translation":"Ils seront accoudés sur des coussins verts et des tapis épais et jolis.","juz":27,"page":534,"surahName":"Ar-Rahmaan","surahNameAr":"سُورَةُ الرَّحۡمَٰن"},{"id":4978,"surah":55,"ayah":77,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","translation":"Lequel donc des bienfaits de votre Seigneur nierez-vous?","juz":27,"page":534,"surahName":"Ar-Rahmaan","surahNameAr":"سُورَةُ الرَّحۡمَٰن"},{"id":4979,"surah":55,"ayah":78,"text":"تَبَٰرَكَ ٱسْمُ رَبِّكَ ذِى ٱلْجَلَٰلِ وَٱلْإِكْرَامِ","translation":"Béni soit le Nom de ton Seigneur, Plein de Majesté et de Munificence!","juz":27,"page":534,"surahName":"Ar-Rahmaan","surahNameAr":"سُورَةُ الرَّحۡمَٰن"},{"id":4980,"surah":56,"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا وَقَعَتِ ٱلْوَاقِعَةُ","translation":"Quand l'événement (le Jugement) arrivera,","juz":27,"page":534,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":4981,"surah":56,"ayah":2,"text":"لَيْسَ لِوَقْعَتِهَا كَاذِبَةٌ","translation":"nul ne traitera sa venue de mensonge.","juz":27,"page":534,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":4982,"surah":56,"ayah":3,"text":"خَافِضَةٌۭ رَّافِعَةٌ","translation":"Il abaissera (les uns), il élèvera (les autres).","juz":27,"page":534,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":4983,"surah":56,"ayah":4,"text":"إِذَا رُجَّتِ ٱلْأَرْضُ رَجًّۭا","translation":"Quand la terre sera secouée violemment,","juz":27,"page":534,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":4984,"surah":56,"ayah":5,"text":"وَبُسَّتِ ٱلْجِبَالُ بَسًّۭا","translation":"et les montagnes seront réduites en miettes,","juz":27,"page":534,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":4985,"surah":56,"ayah":6,"text":"فَكَانَتْ هَبَآءًۭ مُّنۢبَثًّۭا","translation":"et qu'elles deviendront poussière éparpillée","juz":27,"page":534,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":4986,"surah":56,"ayah":7,"text":"وَكُنتُمْ أَزْوَٰجًۭا ثَلَٰثَةًۭ","translation":"alors vous serez trois catégories:","juz":27,"page":534,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":4987,"surah":56,"ayah":8,"text":"فَأَصْحَٰبُ ٱلْمَيْمَنَةِ مَآ أَصْحَٰبُ ٱلْمَيْمَنَةِ","translation":"les gens de la droite - que sont les gens de la droite?","juz":27,"page":534,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":4988,"surah":56,"ayah":9,"text":"وَأَصْحَٰبُ ٱلْمَشْـَٔمَةِ مَآ أَصْحَٰبُ ٱلْمَشْـَٔمَةِ","translation":"Et les gens de la gauche - que sont les gens de la gauche?","juz":27,"page":534,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":4989,"surah":56,"ayah":10,"text":"وَٱلسَّٰبِقُونَ ٱلسَّٰبِقُونَ","translation":"Les premiers (à suivre les ordres d'Allah sur la terre) ce sont eux qui seront les premiers (dans l'au-delà)","juz":27,"page":534,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":4990,"surah":56,"ayah":11,"text":"أُو۟لَٰٓئِكَ ٱلْمُقَرَّبُونَ","translation":"Ce sont ceux-là les plus rapprochés d'Allah","juz":27,"page":534,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":4991,"surah":56,"ayah":12,"text":"فِى جَنَّٰتِ ٱلنَّعِيمِ","translation":"dans les Jardins des délices,","juz":27,"page":534,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":4992,"surah":56,"ayah":13,"text":"ثُلَّةٌۭ مِّنَ ٱلْأَوَّلِينَ","translation":"une multitude d'élus parmi les premières [générations],","juz":27,"page":534,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":4993,"surah":56,"ayah":14,"text":"وَقَلِيلٌۭ مِّنَ ٱلْءَاخِرِينَ","translation":"et un petit nombre parmi les dernières [générations],","juz":27,"page":534,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":4994,"surah":56,"ayah":15,"text":"عَلَىٰ سُرُرٍۢ مَّوْضُونَةٍۢ","translation":"sur des lits ornés [d'or et de pierreries],","juz":27,"page":534,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":4995,"surah":56,"ayah":16,"text":"مُّتَّكِـِٔينَ عَلَيْهَا مُتَقَٰبِلِينَ","translation":"s'y accoudant et se faisant face.","juz":27,"page":534,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"}]