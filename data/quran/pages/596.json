[{"id":6073,"surah":92,"ayah":15,"text":"لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى","translation":"où ne brûlera que le damné,","juz":30,"page":596,"surahName":"Al-Lail","surahNameAr":"سُورَةُ اللَّيۡلِ"},{"id":6074,"surah":92,"ayah":16,"text":"ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ","translation":"qui dément et tourne le dos;","juz":30,"page":596,"surahName":"Al-Lail","surahNameAr":"سُورَةُ اللَّيۡلِ"},{"id":6075,"surah":92,"ayah":17,"text":"وَسَيُجَنَّبُهَا ٱلْأَتْقَى","translation":"alors qu'en sera écarté le pieux,","juz":30,"page":596,"surahName":"Al-Lail","surahNameAr":"سُورَةُ اللَّيۡلِ"},{"id":6076,"surah":92,"ayah":18,"text":"ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ","translation":"qui donne ses biens pour se purifier","juz":30,"page":596,"surahName":"Al-Lail","surahNameAr":"سُورَةُ اللَّيۡلِ"},{"id":6077,"surah":92,"ayah":19,"text":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍۢ تُجْزَىٰٓ","translation":"et auprès de qui personne ne profite d'un bienfait intéressé,","juz":30,"page":596,"surahName":"Al-Lail","surahNameAr":"سُورَةُ اللَّيۡلِ"},{"id":6078,"surah":92,"ayah":20,"text":"إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ","translation":"mais seulement pour la recherche de La Face de son Seigneur le Très Haut.","juz":30,"page":596,"surahName":"Al-Lail","surahNameAr":"سُورَةُ اللَّيۡلِ"},{"id":6079,"surah":92,"ayah":21,"text":"وَلَسَوْفَ يَرْضَىٰ","translation":"Et certes, il sera bientôt satisfait!","juz":30,"page":596,"surahName":"Al-Lail","surahNameAr":"سُورَةُ اللَّيۡلِ"},{"id":6080,"surah":93,"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلضُّحَىٰ","translation":"Par le Jour Montant!","juz":30,"page":596,"surahName":"Ad-Dhuhaa","surahNameAr":"سُورَةُ الضُّحَىٰ"},{"id":6081,"surah":93,"ayah":2,"text":"وَٱلَّيْلِ إِذَا سَجَىٰ","translation":"Et par la nuit quand elle couvre tout!","juz":30,"page":596,"surahName":"Ad-Dhuhaa","surahNameAr":"سُورَةُ الضُّحَىٰ"},{"id":6082,"surah":93,"ayah":3,"text":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ","translation":"Ton Seigneur ne t'a ni abandonné, ni détesté.","juz":30,"page":596,"surahName":"Ad-Dhuhaa","surahNameAr":"سُورَةُ الضُّحَىٰ"},{"id":6083,"surah":93,"ayah":4,"text":"وَلَلْءَاخِرَةُ خَيْرٌۭ لَّكَ مِنَ ٱلْأُولَىٰ","translation":"La vie dernière t'est, certes, meilleure que la vie présente.","juz":30,"page":596,"surahName":"Ad-Dhuhaa","surahNameAr":"سُورَةُ الضُّحَىٰ"},{"id":6084,"surah":93,"ayah":5,"text":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ","translation":"Ton Seigneur t'accordera certes [Ses faveurs], et alors tu seras satisfait.","juz":30,"page":596,"surahName":"Ad-Dhuhaa","surahNameAr":"سُورَةُ الضُّحَىٰ"},{"id":6085,"surah":93,"ayah":6,"text":"أَلَمْ يَجِدْكَ يَتِيمًۭا فَـَٔاوَىٰ","translation":"Ne t'a-t-Il pas trouvé orphelin? Alors Il t'a accueilli!","juz":30,"page":596,"surahName":"Ad-Dhuhaa","surahNameAr":"سُورَةُ الضُّحَىٰ"},{"id":6086,"surah":93,"ayah":7,"text":"وَوَجَدَكَ ضَآلًّۭا فَهَدَىٰ","translation":"Ne t'a-t-Il pas trouvé égaré? Alors Il t'a guidé.","juz":30,"page":596,"surahName":"Ad-Dhuhaa","surahNameAr":"سُورَةُ الضُّحَىٰ"},{"id":6087,"surah":93,"ayah":8,"text":"وَوَجَدَكَ عَآئِلًۭا فَأَغْنَىٰ","translation":"Ne t'a-t-Il pas trouvé pauvre? Alors Il t'a enrichi.","juz":30,"page":596,"surahName":"Ad-Dhuhaa","surahNameAr":"سُورَةُ الضُّحَىٰ"},{"id":6088,"surah":93,"ayah":9,"text":"فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ","translation":"Quant à l'orphelin, donc, ne le maltraite pas.","juz":30,"page":596,"surahName":"Ad-Dhuhaa","surahNameAr":"سُورَةُ الضُّحَىٰ"},{"id":6089,"surah":93,"ayah":10,"text":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ","translation":"Quant au demandeur, ne le repousse pas.","juz":30,"page":596,"surahName":"Ad-Dhuhaa","surahNameAr":"سُورَةُ الضُّحَىٰ"},{"id":6090,"surah":93,"ayah":11,"text":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ","translation":"Et quant au bienfait de ton Seigneur, proclame-le.","juz":30,"page":596,"surahName":"Ad-Dhuhaa","surahNameAr":"سُورَةُ الضُّحَىٰ"},{"id":6091,"surah":94,"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ","translation":"N'avons-Nous pas ouvert pour toi ta poitrine?","juz":30,"page":596,"surahName":"Ash-Sharh","surahNameAr":"سُورَةُ الشَّرۡحِ"},{"id":6092,"surah":94,"ayah":2,"text":"وَوَضَعْنَا عَنكَ وِزْرَكَ","translation":"Et ne t'avons-Nous pas déchargé du fardeau","juz":30,"page":596,"surahName":"Ash-Sharh","surahNameAr":"سُورَةُ الشَّرۡحِ"},{"id":6093,"surah":94,"ayah":3,"text":"ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ","translation":"qui accablait ton dos?","juz":30,"page":596,"surahName":"Ash-Sharh","surahNameAr":"سُورَةُ الشَّرۡحِ"},{"id":6094,"surah":94,"ayah":4,"text":"وَرَفَعْنَا لَكَ ذِكْرَكَ","translation":"Et exalté pour toi ta renommée?","juz":30,"page":596,"surahName":"Ash-Sharh","surahNameAr":"سُورَةُ الشَّرۡحِ"},{"id":6095,"surah":94,"ayah":5,"text":"فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","translation":"A côté de la difficulté est, certes, une facilité!","juz":30,"page":596,"surahName":"Ash-Sharh","surahNameAr":"سُورَةُ الشَّرۡحِ"},{"id":6096,"surah":94,"ayah":6,"text":"إِنَّ مَعَ ٱلْعُسْرِ يُسْرًۭا","translation":"A côté de la difficulté est, certes, une facilité!","juz":30,"page":596,"surahName":"Ash-Sharh","surahNameAr":"سُورَةُ الشَّرۡحِ"},{"id":6097,"surah":94,"ayah":7,"text":"فَإِذَا فَرَغْتَ فَٱنصَبْ","translation":"Quand tu te libères, donc, lève-toi,","juz":30,"page":596,"surahName":"Ash-Sharh","surahNameAr":"سُورَةُ الشَّرۡحِ"},{"id":6098,"surah":94,"ayah":8,"text":"وَإِلَىٰ رَبِّكَ فَٱرْغَب","translation":"et à ton Seigneur aspire.","juz":30,"page":596,"surahName":"Ash-Sharh","surahNameAr":"سُورَةُ الشَّرۡحِ"}]