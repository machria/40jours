[{"id":5801,"surah":81,"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلشَّمْسُ كُوِّرَتْ","translation":"Quand le soleil sera obscurci,","juz":30,"page":586,"surahName":"At-Takwir","surahNameAr":"سُورَةُ التَّكۡوِيرِ"},{"id":5802,"surah":81,"ayah":2,"text":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ","translation":"et que les étoiles deviendront ternes,","juz":30,"page":586,"surahName":"At-Takwir","surahNameAr":"سُورَةُ التَّكۡوِيرِ"},{"id":5803,"surah":81,"ayah":3,"text":"وَإِذَا ٱلْجِبَالُ سُيِّرَتْ","translation":"et les montagnes mises en marche,","juz":30,"page":586,"surahName":"At-Takwir","surahNameAr":"سُورَةُ التَّكۡوِيرِ"},{"id":5804,"surah":81,"ayah":4,"text":"وَإِذَا ٱلْعِشَارُ عُطِّلَتْ","translation":"et les chamelles à terme, négligées,","juz":30,"page":586,"surahName":"At-Takwir","surahNameAr":"سُورَةُ التَّكۡوِيرِ"},{"id":5805,"surah":81,"ayah":5,"text":"وَإِذَا ٱلْوُحُوشُ حُشِرَتْ","translation":"et les bêtes farouches, rassemblées,","juz":30,"page":586,"surahName":"At-Takwir","surahNameAr":"سُورَةُ التَّكۡوِيرِ"},{"id":5806,"surah":81,"ayah":6,"text":"وَإِذَا ٱلْبِحَارُ سُجِّرَتْ","translation":"et les mers allumées,","juz":30,"page":586,"surahName":"At-Takwir","surahNameAr":"سُورَةُ التَّكۡوِيرِ"},{"id":5807,"surah":81,"ayah":7,"text":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ","translation":"et les âmes accouplées","juz":30,"page":586,"surahName":"At-Takwir","surahNameAr":"سُورَةُ التَّكۡوِيرِ"},{"id":5808,"surah":81,"ayah":8,"text":"وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ","translation":"et qu'on demandera à la fillette enterrée vivante","juz":30,"page":586,"surahName":"At-Takwir","surahNameAr":"سُورَةُ التَّكۡوِيرِ"},{"id":5809,"surah":81,"ayah":9,"text":"بِأَىِّ ذَنۢبٍۢ قُتِلَتْ","translation":"pour quel péché elle a été tuée.","juz":30,"page":586,"surahName":"At-Takwir","surahNameAr":"سُورَةُ التَّكۡوِيرِ"},{"id":5810,"surah":81,"ayah":10,"text":"وَإِذَا ٱلصُّحُفُ نُشِرَتْ","translation":"Et quand les feuilles seront déployées,","juz":30,"page":586,"surahName":"At-Takwir","surahNameAr":"سُورَةُ التَّكۡوِيرِ"},{"id":5811,"surah":81,"ayah":11,"text":"وَإِذَا ٱلسَّمَآءُ كُشِطَتْ","translation":"et le ciel écorché","juz":30,"page":586,"surahName":"At-Takwir","surahNameAr":"سُورَةُ التَّكۡوِيرِ"},{"id":5812,"surah":81,"ayah":12,"text":"وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ","translation":"et la fournaise attisée,","juz":30,"page":586,"surahName":"At-Takwir","surahNameAr":"سُورَةُ التَّكۡوِيرِ"},{"id":5813,"surah":81,"ayah":13,"text":"وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ","translation":"et le Paradis rapproché,","juz":30,"page":586,"surahName":"At-Takwir","surahNameAr":"سُورَةُ التَّكۡوِيرِ"},{"id":5814,"surah":81,"ayah":14,"text":"عَلِمَتْ نَفْسٌۭ مَّآ أَحْضَرَتْ","translation":"chaque âme saura ce qu'elle a présenté.","juz":30,"page":586,"surahName":"At-Takwir","surahNameAr":"سُورَةُ التَّكۡوِيرِ"},{"id":5815,"surah":81,"ayah":15,"text":"فَلَآ أُقْسِمُ بِٱلْخُنَّسِ","translation":"Non!... Je jure par les planètes qui gravitent","juz":30,"page":586,"surahName":"At-Takwir","surahNameAr":"سُورَةُ التَّكۡوِيرِ"},{"id":5816,"surah":81,"ayah":16,"text":"ٱلْجَوَارِ ٱلْكُنَّسِ","translation":"qui courent et disparaissent","juz":30,"page":586,"surahName":"At-Takwir","surahNameAr":"سُورَةُ التَّكۡوِيرِ"},{"id":5817,"surah":81,"ayah":17,"text":"وَٱلَّيْلِ إِذَا عَسْعَسَ","translation":"par la nuit quand elle survient!","juz":30,"page":586,"surahName":"At-Takwir","surahNameAr":"سُورَةُ التَّكۡوِيرِ"},{"id":5818,"surah":81,"ayah":18,"text":"وَٱلصُّبْحِ إِذَا تَنَفَّسَ","translation":"et par l'aube quand elle exhale son souffle!","juz":30,"page":586,"surahName":"At-Takwir","surahNameAr":"سُورَةُ التَّكۡوِيرِ"},{"id":5819,"surah":81,"ayah":19,"text":"إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ","translation":"Ceci [le Coran] est la parole d'un noble Messager,","juz":30,"page":586,"surahName":"At-Takwir","surahNameAr":"سُورَةُ التَّكۡوِيرِ"},{"id":5820,"surah":81,"ayah":20,"text":"ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍۢ","translation":"doué d'une grande force, et ayant un rang élevé auprès du Maître du Trône,","juz":30,"page":586,"surahName":"At-Takwir","surahNameAr":"سُورَةُ التَّكۡوِيرِ"},{"id":5821,"surah":81,"ayah":21,"text":"مُّطَاعٍۢ ثَمَّ أَمِينٍۢ","translation":"obéi, là-haut, et digne de confiance.","juz":30,"page":586,"surahName":"At-Takwir","surahNameAr":"سُورَةُ التَّكۡوِيرِ"},{"id":5822,"surah":81,"ayah":22,"text":"وَمَا صَاحِبُكُم بِمَجْنُونٍۢ","translation":"Votre compagnon (Muhammad) n'est nullement fou;","juz":30,"page":586,"surahName":"At-Takwir","surahNameAr":"سُورَةُ التَّكۡوِيرِ"},{"id":5823,"surah":81,"ayah":23,"text":"وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ","translation":"il l'a effectivement vu (Gabriel), au clair horizon","juz":30,"page":586,"surahName":"At-Takwir","surahNameAr":"سُورَةُ التَّكۡوِيرِ"},{"id":5824,"surah":81,"ayah":24,"text":"وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍۢ","translation":"et il ne garde pas avarement pour lui-même ce qui lui a été révélé.","juz":30,"page":586,"surahName":"At-Takwir","surahNameAr":"سُورَةُ التَّكۡوِيرِ"},{"id":5825,"surah":81,"ayah":25,"text":"وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍۢ رَّجِيمٍۢ","translation":"Et ceci [le Coran] n'est point la parole d'un diable banni.","juz":30,"page":586,"surahName":"At-Takwir","surahNameAr":"سُورَةُ التَّكۡوِيرِ"},{"id":5826,"surah":81,"ayah":26,"text":"فَأَيْنَ تَذْهَبُونَ","translation":"Où allez-vous donc?","juz":30,"page":586,"surahName":"At-Takwir","surahNameAr":"سُورَةُ التَّكۡوِيرِ"},{"id":5827,"surah":81,"ayah":27,"text":"إِنْ هُوَ إِلَّا ذِكْرٌۭ لِّلْعَٰلَمِينَ","translation":"Ceci n'est qu'un rappel pour l'univers,","juz":30,"page":586,"surahName":"At-Takwir","surahNameAr":"سُورَةُ التَّكۡوِيرِ"},{"id":5828,"surah":81,"ayah":28,"text":"لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ","translation":"pour celui d'entre vous qui veut suivre le chemin droit.","juz":30,"page":586,"surahName":"At-Takwir","surahNameAr":"سُورَةُ التَّكۡوِيرِ"},{"id":5829,"surah":81,"ayah":29,"text":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ","translation":"Mais vous ne pouvez vouloir, que si Allah veut, [Lui], le Seigneur de l'Univers ;","juz":30,"page":586,"surahName":"At-Takwir","surahNameAr":"سُورَةُ التَّكۡوِيرِ"}]