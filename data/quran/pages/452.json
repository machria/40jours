[{"id":3942,"surah":37,"ayah":154,"text":"مَا لَكُمْ كَيْفَ تَحْكُمُونَ","translation":"Qu'avez-vous donc à juger ainsi?","juz":23,"page":452,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3943,"surah":37,"ayah":155,"text":"أَفَلَا تَذَكَّرُونَ","translation":"Ne réfléchissez-vous donc pas?","juz":23,"page":452,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3944,"surah":37,"ayah":156,"text":"أَمْ لَكُمْ سُلْطَٰنٌۭ مُّبِينٌۭ","translation":"Ou avez-vous un argument évident?","juz":23,"page":452,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3945,"surah":37,"ayah":157,"text":"فَأْتُوا۟ بِكِتَٰبِكُمْ إِن كُنتُمْ صَٰدِقِينَ","translation":"Apportez donc votre Livre si vous êtes véridiques!»","juz":23,"page":452,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3946,"surah":37,"ayah":158,"text":"وَجَعَلُوا۟ بَيْنَهُۥ وَبَيْنَ ٱلْجِنَّةِ نَسَبًۭا ۚ وَلَقَدْ عَلِمَتِ ٱلْجِنَّةُ إِنَّهُمْ لَمُحْضَرُونَ","translation":"Et ils ont établi entre Lui et les djinns une parenté, alors que les djinns savent bien qu'ils [les mécréants] vont être emmenés (pour le châtiment).","juz":23,"page":452,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3947,"surah":37,"ayah":159,"text":"سُبْحَٰنَ ٱللَّهِ عَمَّا يَصِفُونَ","translation":"Gloire à Allah. Il est au-dessus de ce qu'ils décrivent!","juz":23,"page":452,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3948,"surah":37,"ayah":160,"text":"إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ","translation":"Exception faite des serviteurs élus d'Allah.","juz":23,"page":452,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3949,"surah":37,"ayah":161,"text":"فَإِنَّكُمْ وَمَا تَعْبُدُونَ","translation":"En vérité, vous et tout ce que vous adorez,","juz":23,"page":452,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3950,"surah":37,"ayah":162,"text":"مَآ أَنتُمْ عَلَيْهِ بِفَٰتِنِينَ","translation":"ne pourrez tenter [personne],","juz":23,"page":452,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3951,"surah":37,"ayah":163,"text":"إِلَّا مَنْ هُوَ صَالِ ٱلْجَحِيمِ","translation":"excepté celui qui sera brûlé dans la Fournaise.","juz":23,"page":452,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3952,"surah":37,"ayah":164,"text":"وَمَا مِنَّآ إِلَّا لَهُۥ مَقَامٌۭ مَّعْلُومٌۭ","translation":"Il n'y en a pas un, parmi nous, qui n'ait une place connue;","juz":23,"page":452,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3953,"surah":37,"ayah":165,"text":"وَإِنَّا لَنَحْنُ ٱلصَّآفُّونَ","translation":"nous sommes certes, les rangés en rangs;","juz":23,"page":452,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3954,"surah":37,"ayah":166,"text":"وَإِنَّا لَنَحْنُ ٱلْمُسَبِّحُونَ","translation":"et c'est nous certes, qui célébrons la gloire [d'Allah].","juz":23,"page":452,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3955,"surah":37,"ayah":167,"text":"وَإِن كَانُوا۟ لَيَقُولُونَ","translation":"Même s'ils disaient:","juz":23,"page":452,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3956,"surah":37,"ayah":168,"text":"لَوْ أَنَّ عِندَنَا ذِكْرًۭا مِّنَ ٱلْأَوَّلِينَ","translation":"«Si nous avions eu un Rappel de [nos] ancêtres,","juz":23,"page":452,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3957,"surah":37,"ayah":169,"text":"لَكُنَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ","translation":"nous aurions été certes les serviteurs élus d'Allah!","juz":23,"page":452,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3958,"surah":37,"ayah":170,"text":"فَكَفَرُوا۟ بِهِۦ ۖ فَسَوْفَ يَعْلَمُونَ","translation":"Ils y ont mécru et ils sauront bientôt.","juz":23,"page":452,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3959,"surah":37,"ayah":171,"text":"وَلَقَدْ سَبَقَتْ كَلِمَتُنَا لِعِبَادِنَا ٱلْمُرْسَلِينَ","translation":"En effet, Notre Parole a déjà été donnée à Nos serviteurs, les Messagers,","juz":23,"page":452,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3960,"surah":37,"ayah":172,"text":"إِنَّهُمْ لَهُمُ ٱلْمَنصُورُونَ","translation":"que ce sont eux qui seront secourus,","juz":23,"page":452,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3961,"surah":37,"ayah":173,"text":"وَإِنَّ جُندَنَا لَهُمُ ٱلْغَٰلِبُونَ","translation":"et que Nos soldats auront le dessus.","juz":23,"page":452,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3962,"surah":37,"ayah":174,"text":"فَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍۢ","translation":"Eloigne-toi d'eux, jusqu'à un certain temps;","juz":23,"page":452,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3963,"surah":37,"ayah":175,"text":"وَأَبْصِرْهُمْ فَسَوْفَ يُبْصِرُونَ","translation":"et observe-les: ils verront bientôt!","juz":23,"page":452,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3964,"surah":37,"ayah":176,"text":"أَفَبِعَذَابِنَا يَسْتَعْجِلُونَ","translation":"Quoi! est-ce Notre châtiment qu'ils cherchent à hâter?","juz":23,"page":452,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3965,"surah":37,"ayah":177,"text":"فَإِذَا نَزَلَ بِسَاحَتِهِمْ فَسَآءَ صَبَاحُ ٱلْمُنذَرِينَ","translation":"Quand il tombera dans leur place, ce sera alors un mauvais matin pour ceux qu'on a avertis!","juz":23,"page":452,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3966,"surah":37,"ayah":178,"text":"وَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍۢ","translation":"Et éloigne-toi d'eux jusqu'à un certain temps;","juz":23,"page":452,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3967,"surah":37,"ayah":179,"text":"وَأَبْصِرْ فَسَوْفَ يُبْصِرُونَ","translation":"et observe; ils verront bientôt!","juz":23,"page":452,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3968,"surah":37,"ayah":180,"text":"سُبْحَٰنَ رَبِّكَ رَبِّ ٱلْعِزَّةِ عَمَّا يَصِفُونَ","translation":"Gloire à ton Seigneur, le Seigneur de la puissance. Il est au-dessus de ce qu'ils décrivent!","juz":23,"page":452,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3969,"surah":37,"ayah":181,"text":"وَسَلَٰمٌ عَلَى ٱلْمُرْسَلِينَ","translation":"Et paix sur les Messagers,","juz":23,"page":452,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3970,"surah":37,"ayah":182,"text":"وَٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ","translation":"et louange à Allah, Seigneur de l'univers!","juz":23,"page":452,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"}]