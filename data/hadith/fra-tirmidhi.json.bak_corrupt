                    "name": "Ahmad Muhammad Shakir",
                    "grade": "Daif"
                },
                {
                    "name": "Al-Albani",
                    "grade": "Daif"
                },
                {
                    "name": "Zubair Ali Zai",
                    "grade": "Daif"
