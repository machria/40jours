[{"id":3915,"surah":37,"ayah":127,"text":"فَكَذَّبُوهُ فَإِنَّهُمْ لَمُحْضَرُونَ","translation":"Ils le traitèrent de menteur. Et bien, ils seront emmenées (au châtiment).","juz":23,"page":451,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3916,"surah":37,"ayah":128,"text":"إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ","translation":"Exception faite des serviteurs élus d'Allah.","juz":23,"page":451,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3917,"surah":37,"ayah":129,"text":"وَتَرَكْنَا عَلَيْهِ فِى ٱلْءَاخِرِينَ","translation":"Et Nous perpétuâmes son renom dans la postérité:","juz":23,"page":451,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3918,"surah":37,"ayah":130,"text":"سَلَٰمٌ عَلَىٰٓ إِلْ يَاسِينَ","translation":"«Paix sur Elie et ses adeptes».","juz":23,"page":451,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3919,"surah":37,"ayah":131,"text":"إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ","translation":"Ainsi récompensons-Nous les bienfaisants,","juz":23,"page":451,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3920,"surah":37,"ayah":132,"text":"إِنَّهُۥ مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ","translation":"car il était du nombre de Nos serviteurs croyants.","juz":23,"page":451,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3921,"surah":37,"ayah":133,"text":"وَإِنَّ لُوطًۭا لَّمِنَ ٱلْمُرْسَلِينَ","translation":"Et Loût était, certes, du nombre des Messagers.","juz":23,"page":451,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3922,"surah":37,"ayah":134,"text":"إِذْ نَجَّيْنَٰهُ وَأَهْلَهُۥٓ أَجْمَعِينَ","translation":"Quand Nous le sauvâmes, lui et sa famille, tout entière,","juz":23,"page":451,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3923,"surah":37,"ayah":135,"text":"إِلَّا عَجُوزًۭا فِى ٱلْغَٰبِرِينَ","translation":"sauf une vieille femme qui devait disparaître avec les autres,","juz":23,"page":451,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3924,"surah":37,"ayah":136,"text":"ثُمَّ دَمَّرْنَا ٱلْءَاخَرِينَ","translation":"Et Nous détruisîmes les autres","juz":23,"page":451,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3925,"surah":37,"ayah":137,"text":"وَإِنَّكُمْ لَتَمُرُّونَ عَلَيْهِم مُّصْبِحِينَ","translation":"Et vous passez certainement auprès d'eux le matin","juz":23,"page":451,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3926,"surah":37,"ayah":138,"text":"وَبِٱلَّيْلِ ۗ أَفَلَا تَعْقِلُونَ","translation":"et la nuit. Ne raisonnez-vous donc pas?","juz":23,"page":451,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3927,"surah":37,"ayah":139,"text":"وَإِنَّ يُونُسَ لَمِنَ ٱلْمُرْسَلِينَ","translation":"Jonas était certes, du nombre des Messagers.","juz":23,"page":451,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3928,"surah":37,"ayah":140,"text":"إِذْ أَبَقَ إِلَى ٱلْفُلْكِ ٱلْمَشْحُونِ","translation":"Quand il s'enfuit vers le bateau comble,","juz":23,"page":451,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3929,"surah":37,"ayah":141,"text":"فَسَاهَمَ فَكَانَ مِنَ ٱلْمُدْحَضِينَ","translation":"Il prit part au tirage au sort qui le désigna pour être jeté [à la mer].","juz":23,"page":451,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3930,"surah":37,"ayah":142,"text":"فَٱلْتَقَمَهُ ٱلْحُوتُ وَهُوَ مُلِيمٌۭ","translation":"Le poisson l'avala alors qu'il était blâmable.","juz":23,"page":451,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3931,"surah":37,"ayah":143,"text":"فَلَوْلَآ أَنَّهُۥ كَانَ مِنَ ٱلْمُسَبِّحِينَ","translation":"S'il n'avait pas été parmi ceux qui glorifient Allah,","juz":23,"page":451,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3932,"surah":37,"ayah":144,"text":"لَلَبِثَ فِى بَطْنِهِۦٓ إِلَىٰ يَوْمِ يُبْعَثُونَ","translation":"il serait demeuré dans son ventre jusqu'au jour où l'on sera ressuscité.","juz":23,"page":451,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3933,"surah":37,"ayah":145,"text":"۞ فَنَبَذْنَٰهُ بِٱلْعَرَآءِ وَهُوَ سَقِيمٌۭ","translation":"Nous le jetâmes sur la terre nue, indisposé qu'il était.","juz":23,"page":451,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3934,"surah":37,"ayah":146,"text":"وَأَنۢبَتْنَا عَلَيْهِ شَجَرَةًۭ مِّن يَقْطِينٍۢ","translation":"Et Nous fîmes pousser au-dessus de lui un plant de courge,","juz":23,"page":451,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3935,"surah":37,"ayah":147,"text":"وَأَرْسَلْنَٰهُ إِلَىٰ مِا۟ئَةِ أَلْفٍ أَوْ يَزِيدُونَ","translation":"et l'envoyâmes ensuite (comme prophète) vers cent mille hommes ou plus.","juz":23,"page":451,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3936,"surah":37,"ayah":148,"text":"فَـَٔامَنُوا۟ فَمَتَّعْنَٰهُمْ إِلَىٰ حِينٍۢ","translation":"Ils crurent, et nous leur donnâmes jouissance de la vie pour un temps.","juz":23,"page":451,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3937,"surah":37,"ayah":149,"text":"فَٱسْتَفْتِهِمْ أَلِرَبِّكَ ٱلْبَنَاتُ وَلَهُمُ ٱلْبَنُونَ","translation":"Pose-leur donc la question: «Ton Seigneur aurait-Il des filles et eux des fils?","juz":23,"page":451,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3938,"surah":37,"ayah":150,"text":"أَمْ خَلَقْنَا ٱلْمَلَٰٓئِكَةَ إِنَٰثًۭا وَهُمْ شَٰهِدُونَ","translation":"Ou bien avons-Nous créé des Anges de sexe féminin, et en sont-ils témoins?».","juz":23,"page":451,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3939,"surah":37,"ayah":151,"text":"أَلَآ إِنَّهُم مِّنْ إِفْكِهِمْ لَيَقُولُونَ","translation":"Certes, ils disent dans leur mensonge:","juz":23,"page":451,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3940,"surah":37,"ayah":152,"text":"وَلَدَ ٱللَّهُ وَإِنَّهُمْ لَكَٰذِبُونَ","translation":"«Allah a engendré» mais ce sont certainement des menteurs!","juz":23,"page":451,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3941,"surah":37,"ayah":153,"text":"أَصْطَفَى ٱلْبَنَاتِ عَلَى ٱلْبَنِينَ","translation":"Aurait-Il choisi des filles de préférence à des fils?","juz":23,"page":451,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"}]