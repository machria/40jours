[{"id":5673,"surah":78,"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَمَّ يَتَسَآءَلُونَ","translation":"Sur quoi s'interrogent-ils mutuellement?","juz":30,"page":582,"surahName":"An-Naba","surahNameAr":"سُورَةُ النَّبَإِ"},{"id":5674,"surah":78,"ayah":2,"text":"عَنِ ٱلنَّبَإِ ٱلْعَظِيمِ","translation":"Sur la grande nouvelle,","juz":30,"page":582,"surahName":"An-Naba","surahNameAr":"سُورَةُ النَّبَإِ"},{"id":5675,"surah":78,"ayah":3,"text":"ٱلَّذِى هُمْ فِيهِ مُخْتَلِفُونَ","translation":"à propos de laquelle ils divergent.","juz":30,"page":582,"surahName":"An-Naba","surahNameAr":"سُورَةُ النَّبَإِ"},{"id":5676,"surah":78,"ayah":4,"text":"كَلَّا سَيَعْلَمُونَ","translation":"Eh bien non! Ils sauront bientôt.","juz":30,"page":582,"surahName":"An-Naba","surahNameAr":"سُورَةُ النَّبَإِ"},{"id":5677,"surah":78,"ayah":5,"text":"ثُمَّ كَلَّا سَيَعْلَمُونَ","translation":"Encore une fois, non! Ils sauront bientôt.","juz":30,"page":582,"surahName":"An-Naba","surahNameAr":"سُورَةُ النَّبَإِ"},{"id":5678,"surah":78,"ayah":6,"text":"أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَٰدًۭا","translation":"N'avons-Nous pas fait de la terre une couche?","juz":30,"page":582,"surahName":"An-Naba","surahNameAr":"سُورَةُ النَّبَإِ"},{"id":5679,"surah":78,"ayah":7,"text":"وَٱلْجِبَالَ أَوْتَادًۭا","translation":"et (placé) les montagnes comme des piquets?","juz":30,"page":582,"surahName":"An-Naba","surahNameAr":"سُورَةُ النَّبَإِ"},{"id":5680,"surah":78,"ayah":8,"text":"وَخَلَقْنَٰكُمْ أَزْوَٰجًۭا","translation":"Nous vous avons créés en couples,","juz":30,"page":582,"surahName":"An-Naba","surahNameAr":"سُورَةُ النَّبَإِ"},{"id":5681,"surah":78,"ayah":9,"text":"وَجَعَلْنَا نَوْمَكُمْ سُبَاتًۭا","translation":"et désigné votre sommeil pour votre repos,","juz":30,"page":582,"surahName":"An-Naba","surahNameAr":"سُورَةُ النَّبَإِ"},{"id":5682,"surah":78,"ayah":10,"text":"وَجَعَلْنَا ٱلَّيْلَ لِبَاسًۭا","translation":"et fait de la nuit un vêtement,","juz":30,"page":582,"surahName":"An-Naba","surahNameAr":"سُورَةُ النَّبَإِ"},{"id":5683,"surah":78,"ayah":11,"text":"وَجَعَلْنَا ٱلنَّهَارَ مَعَاشًۭا","translation":"et assigné le jour pour les affaires de la vie,","juz":30,"page":582,"surahName":"An-Naba","surahNameAr":"سُورَةُ النَّبَإِ"},{"id":5684,"surah":78,"ayah":12,"text":"وَبَنَيْنَا فَوْقَكُمْ سَبْعًۭا شِدَادًۭا","translation":"et construit au-dessus de vous sept (cieux) renforcés,","juz":30,"page":582,"surahName":"An-Naba","surahNameAr":"سُورَةُ النَّبَإِ"},{"id":5685,"surah":78,"ayah":13,"text":"وَجَعَلْنَا سِرَاجًۭا وَهَّاجًۭا","translation":"et [y] avons placé une lampe (le soleil) très ardente,","juz":30,"page":582,"surahName":"An-Naba","surahNameAr":"سُورَةُ النَّبَإِ"},{"id":5686,"surah":78,"ayah":14,"text":"وَأَنزَلْنَا مِنَ ٱلْمُعْصِرَٰتِ مَآءًۭ ثَجَّاجًۭا","translation":"et fait descendre des nuées une eau abondante","juz":30,"page":582,"surahName":"An-Naba","surahNameAr":"سُورَةُ النَّبَإِ"},{"id":5687,"surah":78,"ayah":15,"text":"لِّنُخْرِجَ بِهِۦ حَبًّۭا وَنَبَاتًۭا","translation":"pour faire pousser par elle grains et plantes","juz":30,"page":582,"surahName":"An-Naba","surahNameAr":"سُورَةُ النَّبَإِ"},{"id":5688,"surah":78,"ayah":16,"text":"وَجَنَّٰتٍ أَلْفَافًا","translation":"et jardins luxuriants.","juz":30,"page":582,"surahName":"An-Naba","surahNameAr":"سُورَةُ النَّبَإِ"},{"id":5689,"surah":78,"ayah":17,"text":"إِنَّ يَوْمَ ٱلْفَصْلِ كَانَ مِيقَٰتًۭا","translation":"Le Jour de la Décision [du Jugement] a son terme fixé.","juz":30,"page":582,"surahName":"An-Naba","surahNameAr":"سُورَةُ النَّبَإِ"},{"id":5690,"surah":78,"ayah":18,"text":"يَوْمَ يُنفَخُ فِى ٱلصُّورِ فَتَأْتُونَ أَفْوَاجًۭا","translation":"Le jour où l'on soufflera dans la Trompe, vous viendrez par troupes,","juz":30,"page":582,"surahName":"An-Naba","surahNameAr":"سُورَةُ النَّبَإِ"},{"id":5691,"surah":78,"ayah":19,"text":"وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًۭا","translation":"et le ciel sera ouvert et [présentera] des portes,","juz":30,"page":582,"surahName":"An-Naba","surahNameAr":"سُورَةُ النَّبَإِ"},{"id":5692,"surah":78,"ayah":20,"text":"وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ سَرَابًا","translation":"et les montagnes seront mises en marche et deviendront un mirage.","juz":30,"page":582,"surahName":"An-Naba","surahNameAr":"سُورَةُ النَّبَإِ"},{"id":5693,"surah":78,"ayah":21,"text":"إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًۭا","translation":"L'Enfer demeure aux aguets,","juz":30,"page":582,"surahName":"An-Naba","surahNameAr":"سُورَةُ النَّبَإِ"},{"id":5694,"surah":78,"ayah":22,"text":"لِّلطَّٰغِينَ مَـَٔابًۭا","translation":"refuge pour les transgresseurs.","juz":30,"page":582,"surahName":"An-Naba","surahNameAr":"سُورَةُ النَّبَإِ"},{"id":5695,"surah":78,"ayah":23,"text":"لَّٰبِثِينَ فِيهَآ أَحْقَابًۭا","translation":"Ils y demeureront pendant des siècles successifs.","juz":30,"page":582,"surahName":"An-Naba","surahNameAr":"سُورَةُ النَّبَإِ"},{"id":5696,"surah":78,"ayah":24,"text":"لَّا يَذُوقُونَ فِيهَا بَرْدًۭا وَلَا شَرَابًا","translation":"Ils n'y goûteront ni fraîcheur ni breuvage,","juz":30,"page":582,"surahName":"An-Naba","surahNameAr":"سُورَةُ النَّبَإِ"},{"id":5697,"surah":78,"ayah":25,"text":"إِلَّا حَمِيمًۭا وَغَسَّاقًۭا","translation":"Hormis une eau bouillante et un pus","juz":30,"page":582,"surahName":"An-Naba","surahNameAr":"سُورَةُ النَّبَإِ"},{"id":5698,"surah":78,"ayah":26,"text":"جَزَآءًۭ وِفَاقًا","translation":"comme rétribution équitable.","juz":30,"page":582,"surahName":"An-Naba","surahNameAr":"سُورَةُ النَّبَإِ"},{"id":5699,"surah":78,"ayah":27,"text":"إِنَّهُمْ كَانُوا۟ لَا يَرْجُونَ حِسَابًۭا","translation":"Car ils ne s'attendaient pas à rendre compte,","juz":30,"page":582,"surahName":"An-Naba","surahNameAr":"سُورَةُ النَّبَإِ"},{"id":5700,"surah":78,"ayah":28,"text":"وَكَذَّبُوا۟ بِـَٔايَٰتِنَا كِذَّابًۭا","translation":"et traitaient de mensonges, continuellement, Nos versets,","juz":30,"page":582,"surahName":"An-Naba","surahNameAr":"سُورَةُ النَّبَإِ"},{"id":5701,"surah":78,"ayah":29,"text":"وَكُلَّ شَىْءٍ أَحْصَيْنَٰهُ كِتَٰبًۭا","translation":"alors que Nous avons dénombré toutes choses en écrit.","juz":30,"page":582,"surahName":"An-Naba","surahNameAr":"سُورَةُ النَّبَإِ"},{"id":5702,"surah":78,"ayah":30,"text":"فَذُوقُوا۟ فَلَن نَّزِيدَكُمْ إِلَّا عَذَابًا","translation":"Goûtez-donc. Nous n'augmenterons pour vous que le châtiment!","juz":30,"page":582,"surahName":"An-Naba","surahNameAr":"سُورَةُ النَّبَإِ"}]