[{"id":5964,"surah":87,"ayah":16,"text":"بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","translation":"Mais, vous préférez plutôt la vie présente,","juz":30,"page":592,"surahName":"Al-A'laa","surahNameAr":"سُورَةُ الأَعۡلَىٰ"},{"id":5965,"surah":87,"ayah":17,"text":"وَٱلْءَاخِرَةُ خَيْرٌۭ وَأَبْقَىٰٓ","translation":"alors que l'au-delà est meilleur et plus durable.","juz":30,"page":592,"surahName":"Al-A'laa","surahNameAr":"سُورَةُ الأَعۡلَىٰ"},{"id":5966,"surah":87,"ayah":18,"text":"إِنَّ هَٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ","translation":"Ceci se trouve, certes, dans les Feuilles anciennes,","juz":30,"page":592,"surahName":"Al-A'laa","surahNameAr":"سُورَةُ الأَعۡلَىٰ"},{"id":5967,"surah":87,"ayah":19,"text":"صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ","translation":"les Feuilles d'Abraham et de Moïse.","juz":30,"page":592,"surahName":"Al-A'laa","surahNameAr":"سُورَةُ الأَعۡلَىٰ"},{"id":5968,"surah":88,"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ","translation":"T'est-il parvenu le récit de l'enveloppante?","juz":30,"page":592,"surahName":"Al-Ghaashiya","surahNameAr":"سُورَةُ الغَاشِيَةِ"},{"id":5969,"surah":88,"ayah":2,"text":"وُجُوهٌۭ يَوْمَئِذٍ خَٰشِعَةٌ","translation":"Ce jour-là, il y aura des visages humiliés,","juz":30,"page":592,"surahName":"Al-Ghaashiya","surahNameAr":"سُورَةُ الغَاشِيَةِ"},{"id":5970,"surah":88,"ayah":3,"text":"عَامِلَةٌۭ نَّاصِبَةٌۭ","translation":"préoccupés, harassés.","juz":30,"page":592,"surahName":"Al-Ghaashiya","surahNameAr":"سُورَةُ الغَاشِيَةِ"},{"id":5971,"surah":88,"ayah":4,"text":"تَصْلَىٰ نَارًا حَامِيَةًۭ","translation":"Ils brûleront dans un Feu ardent,","juz":30,"page":592,"surahName":"Al-Ghaashiya","surahNameAr":"سُورَةُ الغَاشِيَةِ"},{"id":5972,"surah":88,"ayah":5,"text":"تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍۢ","translation":"et seront abreuvés d'une source bouillante.","juz":30,"page":592,"surahName":"Al-Ghaashiya","surahNameAr":"سُورَةُ الغَاشِيَةِ"},{"id":5973,"surah":88,"ayah":6,"text":"لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍۢ","translation":"Il n'y aura pour eux d'autre nourriture que des plantes épineuses [darî'],","juz":30,"page":592,"surahName":"Al-Ghaashiya","surahNameAr":"سُورَةُ الغَاشِيَةِ"},{"id":5974,"surah":88,"ayah":7,"text":"لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍۢ","translation":"qui n'engraisse, ni n'apaise la faim.","juz":30,"page":592,"surahName":"Al-Ghaashiya","surahNameAr":"سُورَةُ الغَاشِيَةِ"},{"id":5975,"surah":88,"ayah":8,"text":"وُجُوهٌۭ يَوْمَئِذٍۢ نَّاعِمَةٌۭ","translation":"Ce jour-là, il y aura des visages épanouis,","juz":30,"page":592,"surahName":"Al-Ghaashiya","surahNameAr":"سُورَةُ الغَاشِيَةِ"},{"id":5976,"surah":88,"ayah":9,"text":"لِّسَعْيِهَا رَاضِيَةٌۭ","translation":"contents de leurs efforts,","juz":30,"page":592,"surahName":"Al-Ghaashiya","surahNameAr":"سُورَةُ الغَاشِيَةِ"},{"id":5977,"surah":88,"ayah":10,"text":"فِى جَنَّةٍ عَالِيَةٍۢ","translation":"dans un haut Jardin,","juz":30,"page":592,"surahName":"Al-Ghaashiya","surahNameAr":"سُورَةُ الغَاشِيَةِ"},{"id":5978,"surah":88,"ayah":11,"text":"لَّا تَسْمَعُ فِيهَا لَٰغِيَةًۭ","translation":"où ils n'entendent aucune futilité.","juz":30,"page":592,"surahName":"Al-Ghaashiya","surahNameAr":"سُورَةُ الغَاشِيَةِ"},{"id":5979,"surah":88,"ayah":12,"text":"فِيهَا عَيْنٌۭ جَارِيَةٌۭ","translation":"Là, il y aura une source coulante.","juz":30,"page":592,"surahName":"Al-Ghaashiya","surahNameAr":"سُورَةُ الغَاشِيَةِ"},{"id":5980,"surah":88,"ayah":13,"text":"فِيهَا سُرُرٌۭ مَّرْفُوعَةٌۭ","translation":"Là, des divans élevés","juz":30,"page":592,"surahName":"Al-Ghaashiya","surahNameAr":"سُورَةُ الغَاشِيَةِ"},{"id":5981,"surah":88,"ayah":14,"text":"وَأَكْوَابٌۭ مَّوْضُوعَةٌۭ","translation":"et des coupes posées","juz":30,"page":592,"surahName":"Al-Ghaashiya","surahNameAr":"سُورَةُ الغَاشِيَةِ"},{"id":5982,"surah":88,"ayah":15,"text":"وَنَمَارِقُ مَصْفُوفَةٌۭ","translation":"et des coussins rangés","juz":30,"page":592,"surahName":"Al-Ghaashiya","surahNameAr":"سُورَةُ الغَاشِيَةِ"},{"id":5983,"surah":88,"ayah":16,"text":"وَزَرَابِىُّ مَبْثُوثَةٌ","translation":"et des tapis étalés.","juz":30,"page":592,"surahName":"Al-Ghaashiya","surahNameAr":"سُورَةُ الغَاشِيَةِ"},{"id":5984,"surah":88,"ayah":17,"text":"أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ","translation":"Ne considèrent-ils donc pas les chameaux, comment ils ont été créés,","juz":30,"page":592,"surahName":"Al-Ghaashiya","surahNameAr":"سُورَةُ الغَاشِيَةِ"},{"id":5985,"surah":88,"ayah":18,"text":"وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ","translation":"et le ciel comment il est élevé,","juz":30,"page":592,"surahName":"Al-Ghaashiya","surahNameAr":"سُورَةُ الغَاشِيَةِ"},{"id":5986,"surah":88,"ayah":19,"text":"وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ","translation":"et les montagnes comment elles sont dressées","juz":30,"page":592,"surahName":"Al-Ghaashiya","surahNameAr":"سُورَةُ الغَاشِيَةِ"},{"id":5987,"surah":88,"ayah":20,"text":"وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ","translation":"et la terre comment elle est nivelée?","juz":30,"page":592,"surahName":"Al-Ghaashiya","surahNameAr":"سُورَةُ الغَاشِيَةِ"},{"id":5988,"surah":88,"ayah":21,"text":"فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌۭ","translation":"Eh bien, rappelle! Tu n'es qu'un rappeleur,","juz":30,"page":592,"surahName":"Al-Ghaashiya","surahNameAr":"سُورَةُ الغَاشِيَةِ"},{"id":5989,"surah":88,"ayah":22,"text":"لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ","translation":"et tu n'es pas un dominateur sur eux.","juz":30,"page":592,"surahName":"Al-Ghaashiya","surahNameAr":"سُورَةُ الغَاشِيَةِ"},{"id":5990,"surah":88,"ayah":23,"text":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ","translation":"Sauf celui qui tourne le dos et ne croit pas,","juz":30,"page":592,"surahName":"Al-Ghaashiya","surahNameAr":"سُورَةُ الغَاشِيَةِ"},{"id":5991,"surah":88,"ayah":24,"text":"فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ","translation":"alors Allah le châtiera du plus grand châtiment.","juz":30,"page":592,"surahName":"Al-Ghaashiya","surahNameAr":"سُورَةُ الغَاشِيَةِ"},{"id":5992,"surah":88,"ayah":25,"text":"إِنَّ إِلَيْنَآ إِيَابَهُمْ","translation":"Vers Nous est leur retour.","juz":30,"page":592,"surahName":"Al-Ghaashiya","surahNameAr":"سُورَةُ الغَاشِيَةِ"},{"id":5993,"surah":88,"ayah":26,"text":"ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم","translation":"Ensuite, c'est à Nous de leur demander compte.","juz":30,"page":592,"surahName":"Al-Ghaashiya","surahNameAr":"سُورَةُ الغَاشِيَةِ"}]