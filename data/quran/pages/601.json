[{"id":6177,"surah":103,"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْعَصْرِ","translation":"Par le Temps!","juz":30,"page":601,"surahName":"Al-Asr","surahNameAr":"سُورَةُ العَصۡرِ"},{"id":6178,"surah":103,"ayah":2,"text":"إِنَّ ٱلْإِنسَٰنَ لَفِى خُسْرٍ","translation":"L'homme est certes, en perdition,","juz":30,"page":601,"surahName":"Al-Asr","surahNameAr":"سُورَةُ العَصۡرِ"},{"id":6179,"surah":103,"ayah":3,"text":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ وَتَوَاصَوْا۟ بِٱلْحَقِّ وَتَوَاصَوْا۟ بِٱلصَّبْرِ","translation":"sauf ceux qui croient et accomplissent les bonnes œuvres, s'enjoignent mutuellement la vérité et s'enjoignent mutuellement l'endurance.","juz":30,"page":601,"surahName":"Al-Asr","surahNameAr":"سُورَةُ العَصۡرِ"},{"id":6180,"surah":104,"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌۭ لِّكُلِّ هُمَزَةٍۢ لُّمَزَةٍ","translation":"Malheur à tout calomniateur diffamateur,","juz":30,"page":601,"surahName":"Al-Humaza","surahNameAr":"سُورَةُ الهُمَزَةِ"},{"id":6181,"surah":104,"ayah":2,"text":"ٱلَّذِى جَمَعَ مَالًۭا وَعَدَّدَهُۥ","translation":"qui amasse une fortune et la compte,","juz":30,"page":601,"surahName":"Al-Humaza","surahNameAr":"سُورَةُ الهُمَزَةِ"},{"id":6182,"surah":104,"ayah":3,"text":"يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ","translation":"pensant que sa fortune l'immortalisera.","juz":30,"page":601,"surahName":"Al-Humaza","surahNameAr":"سُورَةُ الهُمَزَةِ"},{"id":6183,"surah":104,"ayah":4,"text":"كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ","translation":"Mais non! Il sera certes, jeté dans la Hutamah.","juz":30,"page":601,"surahName":"Al-Humaza","surahNameAr":"سُورَةُ الهُمَزَةِ"},{"id":6184,"surah":104,"ayah":5,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ","translation":"Et qui te dira ce qu'est la Hutamah?","juz":30,"page":601,"surahName":"Al-Humaza","surahNameAr":"سُورَةُ الهُمَزَةِ"},{"id":6185,"surah":104,"ayah":6,"text":"نَارُ ٱللَّهِ ٱلْمُوقَدَةُ","translation":"Le Feu attisé d'Allah","juz":30,"page":601,"surahName":"Al-Humaza","surahNameAr":"سُورَةُ الهُمَزَةِ"},{"id":6186,"surah":104,"ayah":7,"text":"ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ","translation":"qui monte jusqu'aux cœurs.","juz":30,"page":601,"surahName":"Al-Humaza","surahNameAr":"سُورَةُ الهُمَزَةِ"},{"id":6187,"surah":104,"ayah":8,"text":"إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌۭ","translation":"Il se refermera sur eux,","juz":30,"page":601,"surahName":"Al-Humaza","surahNameAr":"سُورَةُ الهُمَزَةِ"},{"id":6188,"surah":104,"ayah":9,"text":"فِى عَمَدٍۢ مُّمَدَّدَةٍۭ","translation":"en colonnes (de flammes) étendues.","juz":30,"page":601,"surahName":"Al-Humaza","surahNameAr":"سُورَةُ الهُمَزَةِ"},{"id":6189,"surah":105,"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَٰبِ ٱلْفِيلِ","translation":"N'as-tu pas vu comment ton Seigneur a agi envers les gens de l'Eléphant?","juz":30,"page":601,"surahName":"Al-Fil","surahNameAr":"سُورَةُ الفِيلِ"},{"id":6190,"surah":105,"ayah":2,"text":"أَلَمْ يَجْعَلْ كَيْدَهُمْ فِى تَضْلِيلٍۢ","translation":"N'a-t-Il pas rendu leur ruse complètement vaine?","juz":30,"page":601,"surahName":"Al-Fil","surahNameAr":"سُورَةُ الفِيلِ"},{"id":6191,"surah":105,"ayah":3,"text":"وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ","translation":"et envoyé sur eux des oiseaux par volées","juz":30,"page":601,"surahName":"Al-Fil","surahNameAr":"سُورَةُ الفِيلِ"},{"id":6192,"surah":105,"ayah":4,"text":"تَرْمِيهِم بِحِجَارَةٍۢ مِّن سِجِّيلٍۢ","translation":"qui leur lançaient des pierres d'argile?","juz":30,"page":601,"surahName":"Al-Fil","surahNameAr":"سُورَةُ الفِيلِ"},{"id":6193,"surah":105,"ayah":5,"text":"فَجَعَلَهُمْ كَعَصْفٍۢ مَّأْكُولٍۭ","translation":"Et Il les a rendus semblables à une paille mâchée.","juz":30,"page":601,"surahName":"Al-Fil","surahNameAr":"سُورَةُ الفِيلِ"}]