[{"id":6222,"surah":112,"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ هُوَ ٱللَّهُ أَحَدٌ","translation":"Dis: «Il est Allah, Unique.","juz":30,"page":604,"surahName":"Al-Ikhlaas","surahNameAr":"سُورَةُ الإِخۡلَاصِ"},{"id":6223,"surah":112,"ayah":2,"text":"ٱللَّهُ ٱلصَّمَدُ","translation":"Allah, Le Seul à être imploré pour ce que nous désirons.","juz":30,"page":604,"surahName":"Al-Ikhlaas","surahNameAr":"سُورَةُ الإِخۡلَاصِ"},{"id":6224,"surah":112,"ayah":3,"text":"لَمْ يَلِدْ وَلَمْ يُولَدْ","translation":"Il n'a jamais engendré, n'a pas été engendré non plus.","juz":30,"page":604,"surahName":"Al-Ikhlaas","surahNameAr":"سُورَةُ الإِخۡلَاصِ"},{"id":6225,"surah":112,"ayah":4,"text":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","translation":"Et nul n'est égal à Lui».","juz":30,"page":604,"surahName":"Al-Ikhlaas","surahNameAr":"سُورَةُ الإِخۡلَاصِ"},{"id":6226,"surah":113,"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ","translation":"Dis: «Je cherche protection auprès du Seigneur de l'aube naissante,","juz":30,"page":604,"surahName":"Al-Falaq","surahNameAr":"سُورَةُ الفَلَقِ"},{"id":6227,"surah":113,"ayah":2,"text":"مِن شَرِّ مَا خَلَقَ","translation":"contre le mal des êtres qu'Il a créés,","juz":30,"page":604,"surahName":"Al-Falaq","surahNameAr":"سُورَةُ الفَلَقِ"},{"id":6228,"surah":113,"ayah":3,"text":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ","translation":"contre le mal de l'obscurité quand elle s'approfondit,","juz":30,"page":604,"surahName":"Al-Falaq","surahNameAr":"سُورَةُ الفَلَقِ"},{"id":6229,"surah":113,"ayah":4,"text":"وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِى ٱلْعُقَدِ","translation":"contre le mal de celles qui soufflent [les sorcières] sur les nœuds,","juz":30,"page":604,"surahName":"Al-Falaq","surahNameAr":"سُورَةُ الفَلَقِ"},{"id":6230,"surah":113,"ayah":5,"text":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ","translation":"et contre le mal de l'envieux quand il envie».","juz":30,"page":604,"surahName":"Al-Falaq","surahNameAr":"سُورَةُ الفَلَقِ"},{"id":6231,"surah":114,"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ","translation":"Dis: «Je cherche protection auprès du Seigneur des hommes.","juz":30,"page":604,"surahName":"An-Naas","surahNameAr":"سُورَةُ النَّاسِ"},{"id":6232,"surah":114,"ayah":2,"text":"مَلِكِ ٱلنَّاسِ","translation":"Le Souverain des hommes,","juz":30,"page":604,"surahName":"An-Naas","surahNameAr":"سُورَةُ النَّاسِ"},{"id":6233,"surah":114,"ayah":3,"text":"إِلَٰهِ ٱلنَّاسِ","translation":"Dieu des hommes,","juz":30,"page":604,"surahName":"An-Naas","surahNameAr":"سُورَةُ النَّاسِ"},{"id":6234,"surah":114,"ayah":4,"text":"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ","translation":"contre le mal du mauvais conseiller, furtif,","juz":30,"page":604,"surahName":"An-Naas","surahNameAr":"سُورَةُ النَّاسِ"},{"id":6235,"surah":114,"ayah":5,"text":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ","translation":"qui souffle le mal dans les poitrines des hommes,","juz":30,"page":604,"surahName":"An-Naas","surahNameAr":"سُورَةُ النَّاسِ"},{"id":6236,"surah":114,"ayah":6,"text":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ","translation":"qu'il (le conseiller) soit un djinn, ou un être humain».","juz":30,"page":604,"surahName":"An-Naas","surahNameAr":"سُورَةُ النَّاسِ"}]