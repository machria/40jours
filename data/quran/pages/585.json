[{"id":5759,"surah":80,"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَبَسَ وَتَوَلَّىٰٓ","translation":"Il s'est renfrogné et il s'est détourné","juz":30,"page":585,"surahName":"Abasa","surahNameAr":"سُورَةُ عَبَسَ"},{"id":5760,"surah":80,"ayah":2,"text":"أَن جَآءَهُ ٱلْأَعْمَىٰ","translation":"parce que l'aveugle est venu à lui.","juz":30,"page":585,"surahName":"Abasa","surahNameAr":"سُورَةُ عَبَسَ"},{"id":5761,"surah":80,"ayah":3,"text":"وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ","translation":"Qui te dit: peut-être [cherche]-t-il à se purifier?","juz":30,"page":585,"surahName":"Abasa","surahNameAr":"سُورَةُ عَبَسَ"},{"id":5762,"surah":80,"ayah":4,"text":"أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ","translation":"ou à se rappeler en sorte que le rappel lui profite?","juz":30,"page":585,"surahName":"Abasa","surahNameAr":"سُورَةُ عَبَسَ"},{"id":5763,"surah":80,"ayah":5,"text":"أَمَّا مَنِ ٱسْتَغْنَىٰ","translation":"Quant à celui qui se complaît dans sa suffisance (pour sa richesse)","juz":30,"page":585,"surahName":"Abasa","surahNameAr":"سُورَةُ عَبَسَ"},{"id":5764,"surah":80,"ayah":6,"text":"فَأَنتَ لَهُۥ تَصَدَّىٰ","translation":"tu vas avec empressement à sa rencontre.","juz":30,"page":585,"surahName":"Abasa","surahNameAr":"سُورَةُ عَبَسَ"},{"id":5765,"surah":80,"ayah":7,"text":"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ","translation":"Or, que t'importe qu'il ne se purifie pas».","juz":30,"page":585,"surahName":"Abasa","surahNameAr":"سُورَةُ عَبَسَ"},{"id":5766,"surah":80,"ayah":8,"text":"وَأَمَّا مَن جَآءَكَ يَسْعَىٰ","translation":"Et quant à celui qui vient à toi avec empressement","juz":30,"page":585,"surahName":"Abasa","surahNameAr":"سُورَةُ عَبَسَ"},{"id":5767,"surah":80,"ayah":9,"text":"وَهُوَ يَخْشَىٰ","translation":"tout en ayant la crainte,","juz":30,"page":585,"surahName":"Abasa","surahNameAr":"سُورَةُ عَبَسَ"},{"id":5768,"surah":80,"ayah":10,"text":"فَأَنتَ عَنْهُ تَلَهَّىٰ","translation":"tu ne t'en soucies pas.","juz":30,"page":585,"surahName":"Abasa","surahNameAr":"سُورَةُ عَبَسَ"},{"id":5769,"surah":80,"ayah":11,"text":"كَلَّآ إِنَّهَا تَذْكِرَةٌۭ","translation":"N'agis plus ainsi! Vraiment ceci est un rappel -","juz":30,"page":585,"surahName":"Abasa","surahNameAr":"سُورَةُ عَبَسَ"},{"id":5770,"surah":80,"ayah":12,"text":"فَمَن شَآءَ ذَكَرَهُۥ","translation":"quiconque veut, donc, s'en rappelle -","juz":30,"page":585,"surahName":"Abasa","surahNameAr":"سُورَةُ عَبَسَ"},{"id":5771,"surah":80,"ayah":13,"text":"فِى صُحُفٍۢ مُّكَرَّمَةٍۢ","translation":"consigné dans des feuilles honorées,","juz":30,"page":585,"surahName":"Abasa","surahNameAr":"سُورَةُ عَبَسَ"},{"id":5772,"surah":80,"ayah":14,"text":"مَّرْفُوعَةٍۢ مُّطَهَّرَةٍۭ","translation":"élevées, purifiées,","juz":30,"page":585,"surahName":"Abasa","surahNameAr":"سُورَةُ عَبَسَ"},{"id":5773,"surah":80,"ayah":15,"text":"بِأَيْدِى سَفَرَةٍۢ","translation":"entre les mains d'ambassadeurs","juz":30,"page":585,"surahName":"Abasa","surahNameAr":"سُورَةُ عَبَسَ"},{"id":5774,"surah":80,"ayah":16,"text":"كِرَامٍۭ بَرَرَةٍۢ","translation":"nobles, obéissants.","juz":30,"page":585,"surahName":"Abasa","surahNameAr":"سُورَةُ عَبَسَ"},{"id":5775,"surah":80,"ayah":17,"text":"قُتِلَ ٱلْإِنسَٰنُ مَآ أَكْفَرَهُۥ","translation":"Que périsse l'homme! Qu'il est ingrat!","juz":30,"page":585,"surahName":"Abasa","surahNameAr":"سُورَةُ عَبَسَ"},{"id":5776,"surah":80,"ayah":18,"text":"مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ","translation":"De quoi [Allah] l'a-t-Il créé?","juz":30,"page":585,"surahName":"Abasa","surahNameAr":"سُورَةُ عَبَسَ"},{"id":5777,"surah":80,"ayah":19,"text":"مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ","translation":"D'une goutte de sperme, Il le crée et détermine (son destin):","juz":30,"page":585,"surahName":"Abasa","surahNameAr":"سُورَةُ عَبَسَ"},{"id":5778,"surah":80,"ayah":20,"text":"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ","translation":"puis Il lui facilite le chemin;","juz":30,"page":585,"surahName":"Abasa","surahNameAr":"سُورَةُ عَبَسَ"},{"id":5779,"surah":80,"ayah":21,"text":"ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ","translation":"puis Il lui donne la mort et le met au tombeau;","juz":30,"page":585,"surahName":"Abasa","surahNameAr":"سُورَةُ عَبَسَ"},{"id":5780,"surah":80,"ayah":22,"text":"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ","translation":"puis Il le ressuscitera quand Il voudra.","juz":30,"page":585,"surahName":"Abasa","surahNameAr":"سُورَةُ عَبَسَ"},{"id":5781,"surah":80,"ayah":23,"text":"كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ","translation":"Eh bien non! [L'homme] n'accomplit pas ce qu'Il lui commande.","juz":30,"page":585,"surahName":"Abasa","surahNameAr":"سُورَةُ عَبَسَ"},{"id":5782,"surah":80,"ayah":24,"text":"فَلْيَنظُرِ ٱلْإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ","translation":"Que l'homme considère donc sa nourriture:","juz":30,"page":585,"surahName":"Abasa","surahNameAr":"سُورَةُ عَبَسَ"},{"id":5783,"surah":80,"ayah":25,"text":"أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّۭا","translation":"C'est Nous qui versons l'eau abondante,","juz":30,"page":585,"surahName":"Abasa","surahNameAr":"سُورَةُ عَبَسَ"},{"id":5784,"surah":80,"ayah":26,"text":"ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّۭا","translation":"puis Nous fendons la terre par fissures","juz":30,"page":585,"surahName":"Abasa","surahNameAr":"سُورَةُ عَبَسَ"},{"id":5785,"surah":80,"ayah":27,"text":"فَأَنۢبَتْنَا فِيهَا حَبًّۭا","translation":"et y faisons pousser grains,","juz":30,"page":585,"surahName":"Abasa","surahNameAr":"سُورَةُ عَبَسَ"},{"id":5786,"surah":80,"ayah":28,"text":"وَعِنَبًۭا وَقَضْبًۭا","translation":"vignobles et légumes,","juz":30,"page":585,"surahName":"Abasa","surahNameAr":"سُورَةُ عَبَسَ"},{"id":5787,"surah":80,"ayah":29,"text":"وَزَيْتُونًۭا وَنَخْلًۭا","translation":"oliviers et palmiers,","juz":30,"page":585,"surahName":"Abasa","surahNameAr":"سُورَةُ عَبَسَ"},{"id":5788,"surah":80,"ayah":30,"text":"وَحَدَآئِقَ غُلْبًۭا","translation":"jardins touffus,","juz":30,"page":585,"surahName":"Abasa","surahNameAr":"سُورَةُ عَبَسَ"},{"id":5789,"surah":80,"ayah":31,"text":"وَفَٰكِهَةًۭ وَأَبًّۭا","translation":"fruits et herbages,","juz":30,"page":585,"surahName":"Abasa","surahNameAr":"سُورَةُ عَبَسَ"},{"id":5790,"surah":80,"ayah":32,"text":"مَّتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ","translation":"pour votre jouissance vous et vos bestiaux.","juz":30,"page":585,"surahName":"Abasa","surahNameAr":"سُورَةُ عَبَسَ"},{"id":5791,"surah":80,"ayah":33,"text":"فَإِذَا جَآءَتِ ٱلصَّآخَّةُ","translation":"Puis quand viendra le Fracas,","juz":30,"page":585,"surahName":"Abasa","surahNameAr":"سُورَةُ عَبَسَ"},{"id":5792,"surah":80,"ayah":34,"text":"يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ","translation":"le jour où l'homme s'enfuira de son frère,","juz":30,"page":585,"surahName":"Abasa","surahNameAr":"سُورَةُ عَبَسَ"},{"id":5793,"surah":80,"ayah":35,"text":"وَأُمِّهِۦ وَأَبِيهِ","translation":"de sa mère, de son père,","juz":30,"page":585,"surahName":"Abasa","surahNameAr":"سُورَةُ عَبَسَ"},{"id":5794,"surah":80,"ayah":36,"text":"وَصَٰحِبَتِهِۦ وَبَنِيهِ","translation":"de sa compagne et de ses enfants,","juz":30,"page":585,"surahName":"Abasa","surahNameAr":"سُورَةُ عَبَسَ"},{"id":5795,"surah":80,"ayah":37,"text":"لِكُلِّ ٱمْرِئٍۢ مِّنْهُمْ يَوْمَئِذٍۢ شَأْنٌۭ يُغْنِيهِ","translation":"car chacun d'eux, ce jour-là, aura son propre cas pour l'occuper.","juz":30,"page":585,"surahName":"Abasa","surahNameAr":"سُورَةُ عَبَسَ"},{"id":5796,"surah":80,"ayah":38,"text":"وُجُوهٌۭ يَوْمَئِذٍۢ مُّسْفِرَةٌۭ","translation":"Ce jour-là, il y aura des visages rayonnants,","juz":30,"page":585,"surahName":"Abasa","surahNameAr":"سُورَةُ عَبَسَ"},{"id":5797,"surah":80,"ayah":39,"text":"ضَاحِكَةٌۭ مُّسْتَبْشِرَةٌۭ","translation":"riants et réjouis.","juz":30,"page":585,"surahName":"Abasa","surahNameAr":"سُورَةُ عَبَسَ"},{"id":5798,"surah":80,"ayah":40,"text":"وَوُجُوهٌۭ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌۭ","translation":"De même qu'il y aura, ce jour-là, des visages couverts de poussière,","juz":30,"page":585,"surahName":"Abasa","surahNameAr":"سُورَةُ عَبَسَ"},{"id":5799,"surah":80,"ayah":41,"text":"تَرْهَقُهَا قَتَرَةٌ","translation":"recouverts de ténèbres.","juz":30,"page":585,"surahName":"Abasa","surahNameAr":"سُورَةُ عَبَسَ"},{"id":5800,"surah":80,"ayah":42,"text":"أُو۟لَٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ","translation":"Voilà les infidèles, les libertins.","juz":30,"page":585,"surahName":"Abasa","surahNameAr":"سُورَةُ عَبَسَ"}]