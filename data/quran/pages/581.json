[{"id":5642,"surah":77,"ayah":20,"text":"أَلَمْ نَخْلُقكُّم مِّن مَّآءٍۢ مَّهِينٍۢ","translation":"Ne vous avons-Nous pas créés d'une eau vile","juz":29,"page":581,"surahName":"Al-Mursalaat","surahNameAr":"سُورَةُ المُرۡسَلَاتِ"},{"id":5643,"surah":77,"ayah":21,"text":"فَجَعَلْنَٰهُ فِى قَرَارٍۢ مَّكِينٍ","translation":"que Nous avons placée dans un reposoir sûr,","juz":29,"page":581,"surahName":"Al-Mursalaat","surahNameAr":"سُورَةُ المُرۡسَلَاتِ"},{"id":5644,"surah":77,"ayah":22,"text":"إِلَىٰ قَدَرٍۢ مَّعْلُومٍۢ","translation":"pour une durée connue?","juz":29,"page":581,"surahName":"Al-Mursalaat","surahNameAr":"سُورَةُ المُرۡسَلَاتِ"},{"id":5645,"surah":77,"ayah":23,"text":"فَقَدَرْنَا فَنِعْمَ ٱلْقَٰدِرُونَ","translation":"Nous l'avons décrété ainsi et Nous décrétons [tout] de façon parfaite.","juz":29,"page":581,"surahName":"Al-Mursalaat","surahNameAr":"سُورَةُ المُرۡسَلَاتِ"},{"id":5646,"surah":77,"ayah":24,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","translation":"Malheur, ce jour-là, à ceux qui criaient au mensonge.","juz":29,"page":581,"surahName":"Al-Mursalaat","surahNameAr":"سُورَةُ المُرۡسَلَاتِ"},{"id":5647,"surah":77,"ayah":25,"text":"أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا","translation":"N'avons-Nous pas fait de la terre un endroit les contenant tous,","juz":29,"page":581,"surahName":"Al-Mursalaat","surahNameAr":"سُورَةُ المُرۡسَلَاتِ"},{"id":5648,"surah":77,"ayah":26,"text":"أَحْيَآءًۭ وَأَمْوَٰتًۭا","translation":"les vivants ainsi que les morts?","juz":29,"page":581,"surahName":"Al-Mursalaat","surahNameAr":"سُورَةُ المُرۡسَلَاتِ"},{"id":5649,"surah":77,"ayah":27,"text":"وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَٰمِخَٰتٍۢ وَأَسْقَيْنَٰكُم مَّآءًۭ فُرَاتًۭا","translation":"Et n'y avons-Nous pas placé fermement de hautes montagnes? Et ne vous avons-Nous pas abreuvés d'eau douce?","juz":29,"page":581,"surahName":"Al-Mursalaat","surahNameAr":"سُورَةُ المُرۡسَلَاتِ"},{"id":5650,"surah":77,"ayah":28,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","translation":"Malheur, ce jour-là, à ceux qui criaient au mensonge.","juz":29,"page":581,"surahName":"Al-Mursalaat","surahNameAr":"سُورَةُ المُرۡسَلَاتِ"},{"id":5651,"surah":77,"ayah":29,"text":"ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ","translation":"Allez vers ce que vous traitiez alors de mensonge!","juz":29,"page":581,"surahName":"Al-Mursalaat","surahNameAr":"سُورَةُ المُرۡسَلَاتِ"},{"id":5652,"surah":77,"ayah":30,"text":"ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّۢ ذِى ثَلَٰثِ شُعَبٍۢ","translation":"Allez vers une ombre [fumée de l'Enfer] à trois branches;","juz":29,"page":581,"surahName":"Al-Mursalaat","surahNameAr":"سُورَةُ المُرۡسَلَاتِ"},{"id":5653,"surah":77,"ayah":31,"text":"لَّا ظَلِيلٍۢ وَلَا يُغْنِى مِنَ ٱللَّهَبِ","translation":"qui n'est ni ombreuse ni capable de protéger contre la flamme;","juz":29,"page":581,"surahName":"Al-Mursalaat","surahNameAr":"سُورَةُ المُرۡسَلَاتِ"},{"id":5654,"surah":77,"ayah":32,"text":"إِنَّهَا تَرْمِى بِشَرَرٍۢ كَٱلْقَصْرِ","translation":"car [le feu] jette des étincelles volumineuses comme des châteaux,","juz":29,"page":581,"surahName":"Al-Mursalaat","surahNameAr":"سُورَةُ المُرۡسَلَاتِ"},{"id":5655,"surah":77,"ayah":33,"text":"كَأَنَّهُۥ جِمَٰلَتٌۭ صُفْرٌۭ","translation":"et qu'on prendrait pour des chameaux jaunes.","juz":29,"page":581,"surahName":"Al-Mursalaat","surahNameAr":"سُورَةُ المُرۡسَلَاتِ"},{"id":5656,"surah":77,"ayah":34,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","translation":"Malheur, ce jour-là, à ceux qui criaient au mensonge.","juz":29,"page":581,"surahName":"Al-Mursalaat","surahNameAr":"سُورَةُ المُرۡسَلَاتِ"},{"id":5657,"surah":77,"ayah":35,"text":"هَٰذَا يَوْمُ لَا يَنطِقُونَ","translation":"Ce sera le jour où ils ne [peuvent] pas parler,","juz":29,"page":581,"surahName":"Al-Mursalaat","surahNameAr":"سُورَةُ المُرۡسَلَاتِ"},{"id":5658,"surah":77,"ayah":36,"text":"وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ","translation":"et point ne leur sera donné permission de s'excuser.","juz":29,"page":581,"surahName":"Al-Mursalaat","surahNameAr":"سُورَةُ المُرۡسَلَاتِ"},{"id":5659,"surah":77,"ayah":37,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","translation":"Malheur, ce jour-là, à ceux qui criaient au mensonge.","juz":29,"page":581,"surahName":"Al-Mursalaat","surahNameAr":"سُورَةُ المُرۡسَلَاتِ"},{"id":5660,"surah":77,"ayah":38,"text":"هَٰذَا يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَٰكُمْ وَٱلْأَوَّلِينَ","translation":"C'est le Jour de la Décision [Jugement], où nous vous réunirons ainsi que les anciens.","juz":29,"page":581,"surahName":"Al-Mursalaat","surahNameAr":"سُورَةُ المُرۡسَلَاتِ"},{"id":5661,"surah":77,"ayah":39,"text":"فَإِن كَانَ لَكُمْ كَيْدٌۭ فَكِيدُونِ","translation":"Si vous disposez d'une ruse, rusez donc contre Moi.","juz":29,"page":581,"surahName":"Al-Mursalaat","surahNameAr":"سُورَةُ المُرۡسَلَاتِ"},{"id":5662,"surah":77,"ayah":40,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","translation":"Malheur, ce jour-là, à ceux qui criaient au mensonge.","juz":29,"page":581,"surahName":"Al-Mursalaat","surahNameAr":"سُورَةُ المُرۡسَلَاتِ"},{"id":5663,"surah":77,"ayah":41,"text":"إِنَّ ٱلْمُتَّقِينَ فِى ظِلَٰلٍۢ وَعُيُونٍۢ","translation":"Les pieux seront parmi des ombrages et des sources","juz":29,"page":581,"surahName":"Al-Mursalaat","surahNameAr":"سُورَةُ المُرۡسَلَاتِ"},{"id":5664,"surah":77,"ayah":42,"text":"وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ","translation":"De même que des fruits selon leurs désirs.","juz":29,"page":581,"surahName":"Al-Mursalaat","surahNameAr":"سُورَةُ المُرۡسَلَاتِ"},{"id":5665,"surah":77,"ayah":43,"text":"كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ","translation":"«Mangez et buvez agréablement, pour ce que vous faisiez».","juz":29,"page":581,"surahName":"Al-Mursalaat","surahNameAr":"سُورَةُ المُرۡسَلَاتِ"},{"id":5666,"surah":77,"ayah":44,"text":"إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ","translation":"C'est ainsi que Nous récompensons les bienfaisants.","juz":29,"page":581,"surahName":"Al-Mursalaat","surahNameAr":"سُورَةُ المُرۡسَلَاتِ"},{"id":5667,"surah":77,"ayah":45,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","translation":"Malheur, ce jour-là, à ceux qui criaient au mensonge.","juz":29,"page":581,"surahName":"Al-Mursalaat","surahNameAr":"سُورَةُ المُرۡسَلَاتِ"},{"id":5668,"surah":77,"ayah":46,"text":"كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ","translation":"«Mangez et jouissez un peu (ici-bas); vous êtes certes des criminels».","juz":29,"page":581,"surahName":"Al-Mursalaat","surahNameAr":"سُورَةُ المُرۡسَلَاتِ"},{"id":5669,"surah":77,"ayah":47,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","translation":"Malheur, ce jour-là, à ceux qui criaient au mensonge.","juz":29,"page":581,"surahName":"Al-Mursalaat","surahNameAr":"سُورَةُ المُرۡسَلَاتِ"},{"id":5670,"surah":77,"ayah":48,"text":"وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ","translation":"Et quand on leur dit: «Inclinez-vous, ils ne s'inclinent pas.","juz":29,"page":581,"surahName":"Al-Mursalaat","surahNameAr":"سُورَةُ المُرۡسَلَاتِ"},{"id":5671,"surah":77,"ayah":49,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","translation":"Malheur, ce jour-là, à ceux qui criaient au mensonge.","juz":29,"page":581,"surahName":"Al-Mursalaat","surahNameAr":"سُورَةُ المُرۡسَلَاتِ"},{"id":5672,"surah":77,"ayah":50,"text":"فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ","translation":"Après cela, en quelle parole croiront-ils donc?","juz":29,"page":581,"surahName":"Al-Mursalaat","surahNameAr":"سُورَةُ المُرۡسَلَاتِ"}]