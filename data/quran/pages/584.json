[{"id":5728,"surah":79,"ayah":16,"text":"إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى","translation":"Quand son Seigneur l'appela, dans Towâ, la vallée sanctifiée:","juz":30,"page":584,"surahName":"An-Naazi'aat","surahNameAr":"سُورَةُ النَّازِعَاتِ"},{"id":5729,"surah":79,"ayah":17,"text":"ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ","translation":"«Va vers Pharaon. Vraiment, il s'est rebellé!»","juz":30,"page":584,"surahName":"An-Naazi'aat","surahNameAr":"سُورَةُ النَّازِعَاتِ"},{"id":5730,"surah":79,"ayah":18,"text":"فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ","translation":"Puis dis-lui: «Voudrais-tu te purifier?","juz":30,"page":584,"surahName":"An-Naazi'aat","surahNameAr":"سُورَةُ النَّازِعَاتِ"},{"id":5731,"surah":79,"ayah":19,"text":"وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ","translation":"et que je te guide vers ton Seigneur afin que tu Le craignes?»","juz":30,"page":584,"surahName":"An-Naazi'aat","surahNameAr":"سُورَةُ النَّازِعَاتِ"},{"id":5732,"surah":79,"ayah":20,"text":"فَأَرَىٰهُ ٱلْءَايَةَ ٱلْكُبْرَىٰ","translation":"Il lui fit voir le très grand miracle.","juz":30,"page":584,"surahName":"An-Naazi'aat","surahNameAr":"سُورَةُ النَّازِعَاتِ"},{"id":5733,"surah":79,"ayah":21,"text":"فَكَذَّبَ وَعَصَىٰ","translation":"Mais il le qualifia de mensonge et désobéit;","juz":30,"page":584,"surahName":"An-Naazi'aat","surahNameAr":"سُورَةُ النَّازِعَاتِ"},{"id":5734,"surah":79,"ayah":22,"text":"ثُمَّ أَدْبَرَ يَسْعَىٰ","translation":"Ensuite, il tourna le dos, s'en alla précipitamment,","juz":30,"page":584,"surahName":"An-Naazi'aat","surahNameAr":"سُورَةُ النَّازِعَاتِ"},{"id":5735,"surah":79,"ayah":23,"text":"فَحَشَرَ فَنَادَىٰ","translation":"rassembla [les gens] et leur fit une proclamation,","juz":30,"page":584,"surahName":"An-Naazi'aat","surahNameAr":"سُورَةُ النَّازِعَاتِ"},{"id":5736,"surah":79,"ayah":24,"text":"فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ","translation":"et dit: «C'est moi votre Seigneur, le très haut».","juz":30,"page":584,"surahName":"An-Naazi'aat","surahNameAr":"سُورَةُ النَّازِعَاتِ"},{"id":5737,"surah":79,"ayah":25,"text":"فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْءَاخِرَةِ وَٱلْأُولَىٰٓ","translation":"Alors Allah le saisit de la punition exemplaire de l'au-delà et de celle d'ici-bas.","juz":30,"page":584,"surahName":"An-Naazi'aat","surahNameAr":"سُورَةُ النَّازِعَاتِ"},{"id":5738,"surah":79,"ayah":26,"text":"إِنَّ فِى ذَٰلِكَ لَعِبْرَةًۭ لِّمَن يَخْشَىٰٓ","translation":"Il y a certes là un sujet de réflexion pour celui qui craint.","juz":30,"page":584,"surahName":"An-Naazi'aat","surahNameAr":"سُورَةُ النَّازِعَاتِ"},{"id":5739,"surah":79,"ayah":27,"text":"ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ ۚ بَنَىٰهَا","translation":"Etes-vous plus durs à créer? ou le ciel, qu'Il a pourtant construit?","juz":30,"page":584,"surahName":"An-Naazi'aat","surahNameAr":"سُورَةُ النَّازِعَاتِ"},{"id":5740,"surah":79,"ayah":28,"text":"رَفَعَ سَمْكَهَا فَسَوَّىٰهَا","translation":"Il a élevé bien haut sa voûte, puis l'a parfaitement ordonné;","juz":30,"page":584,"surahName":"An-Naazi'aat","surahNameAr":"سُورَةُ النَّازِعَاتِ"},{"id":5741,"surah":79,"ayah":29,"text":"وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا","translation":"Il a assombri sa nuit et fait luire son jour.","juz":30,"page":584,"surahName":"An-Naazi'aat","surahNameAr":"سُورَةُ النَّازِعَاتِ"},{"id":5742,"surah":79,"ayah":30,"text":"وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ","translation":"Et quant à la terre, après cela, Il l'a étendue:","juz":30,"page":584,"surahName":"An-Naazi'aat","surahNameAr":"سُورَةُ النَّازِعَاتِ"},{"id":5743,"surah":79,"ayah":31,"text":"أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَىٰهَا","translation":"Il a fait sortir d'elle son eau et son pâturage,","juz":30,"page":584,"surahName":"An-Naazi'aat","surahNameAr":"سُورَةُ النَّازِعَاتِ"},{"id":5744,"surah":79,"ayah":32,"text":"وَٱلْجِبَالَ أَرْسَىٰهَا","translation":"et quant aux montagnes, Il les a ancrées,","juz":30,"page":584,"surahName":"An-Naazi'aat","surahNameAr":"سُورَةُ النَّازِعَاتِ"},{"id":5745,"surah":79,"ayah":33,"text":"مَتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ","translation":"pour votre jouissance, vous et vos bestiaux.","juz":30,"page":584,"surahName":"An-Naazi'aat","surahNameAr":"سُورَةُ النَّازِعَاتِ"},{"id":5746,"surah":79,"ayah":34,"text":"فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلْكُبْرَىٰ","translation":"Puis quand viendra le grand cataclysme,","juz":30,"page":584,"surahName":"An-Naazi'aat","surahNameAr":"سُورَةُ النَّازِعَاتِ"},{"id":5747,"surah":79,"ayah":35,"text":"يَوْمَ يَتَذَكَّرُ ٱلْإِنسَٰنُ مَا سَعَىٰ","translation":"le jour où l'homme se rappellera à quoi il s'est efforcé,","juz":30,"page":584,"surahName":"An-Naazi'aat","surahNameAr":"سُورَةُ النَّازِعَاتِ"},{"id":5748,"surah":79,"ayah":36,"text":"وَبُرِّزَتِ ٱلْجَحِيمُ لِمَن يَرَىٰ","translation":"l'Enfer sera pleinement visible à celui qui regardera...","juz":30,"page":584,"surahName":"An-Naazi'aat","surahNameAr":"سُورَةُ النَّازِعَاتِ"},{"id":5749,"surah":79,"ayah":37,"text":"فَأَمَّا مَن طَغَىٰ","translation":"Quant à celui qui aura dépassé les limites","juz":30,"page":584,"surahName":"An-Naazi'aat","surahNameAr":"سُورَةُ النَّازِعَاتِ"},{"id":5750,"surah":79,"ayah":38,"text":"وَءَاثَرَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","translation":"et aura préféré la vie présente,","juz":30,"page":584,"surahName":"An-Naazi'aat","surahNameAr":"سُورَةُ النَّازِعَاتِ"},{"id":5751,"surah":79,"ayah":39,"text":"فَإِنَّ ٱلْجَحِيمَ هِىَ ٱلْمَأْوَىٰ","translation":"alors, l'Enfer sera son refuge...","juz":30,"page":584,"surahName":"An-Naazi'aat","surahNameAr":"سُورَةُ النَّازِعَاتِ"},{"id":5752,"surah":79,"ayah":40,"text":"وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفْسَ عَنِ ٱلْهَوَىٰ","translation":"Et pour celui qui aura redouté de comparaître devant son Seigneur, et préservé son âme de la passion,","juz":30,"page":584,"surahName":"An-Naazi'aat","surahNameAr":"سُورَةُ النَّازِعَاتِ"},{"id":5753,"surah":79,"ayah":41,"text":"فَإِنَّ ٱلْجَنَّةَ هِىَ ٱلْمَأْوَىٰ","translation":"le Paradis sera alors son refuge.","juz":30,"page":584,"surahName":"An-Naazi'aat","surahNameAr":"سُورَةُ النَّازِعَاتِ"},{"id":5754,"surah":79,"ayah":42,"text":"يَسْـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرْسَىٰهَا","translation":"Ils t'interrogent au sujet de l'Heure: «Quand va-t-elle jeter l'ancre?»","juz":30,"page":584,"surahName":"An-Naazi'aat","surahNameAr":"سُورَةُ النَّازِعَاتِ"},{"id":5755,"surah":79,"ayah":43,"text":"فِيمَ أَنتَ مِن ذِكْرَىٰهَآ","translation":"Quelle [science] en as-tu pour le leur dire?","juz":30,"page":584,"surahName":"An-Naazi'aat","surahNameAr":"سُورَةُ النَّازِعَاتِ"},{"id":5756,"surah":79,"ayah":44,"text":"إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ","translation":"Son terme n'est connu que de ton Seigneur.","juz":30,"page":584,"surahName":"An-Naazi'aat","surahNameAr":"سُورَةُ النَّازِعَاتِ"},{"id":5757,"surah":79,"ayah":45,"text":"إِنَّمَآ أَنتَ مُنذِرُ مَن يَخْشَىٰهَا","translation":"Tu n'es que l'avertisseur de celui qui la redoute.","juz":30,"page":584,"surahName":"An-Naazi'aat","surahNameAr":"سُورَةُ النَّازِعَاتِ"},{"id":5758,"surah":79,"ayah":46,"text":"كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوٓا۟ إِلَّا عَشِيَّةً أَوْ ضُحَىٰهَا","translation":"Le jour où ils la verront, il leur semblera n'avoir demeuré qu'un soir ou un matin.","juz":30,"page":584,"surahName":"An-Naazi'aat","surahNameAr":"سُورَةُ النَّازِعَاتِ"}]