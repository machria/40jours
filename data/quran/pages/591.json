[{"id":5932,"surah":86,"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ وَٱلطَّارِقِ","translation":"Par le ciel et par l'astre nocturne","juz":30,"page":591,"surahName":"At-Taariq","surahNameAr":"سُورَةُ الطَّارِقِ"},{"id":5933,"surah":86,"ayah":2,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ","translation":"Et qui te dira ce qu'est l'astre nocturne?","juz":30,"page":591,"surahName":"At-Taariq","surahNameAr":"سُورَةُ الطَّارِقِ"},{"id":5934,"surah":86,"ayah":3,"text":"ٱلنَّجْمُ ٱلثَّاقِبُ","translation":"C'est l'étoile vivement brillante.","juz":30,"page":591,"surahName":"At-Taariq","surahNameAr":"سُورَةُ الطَّارِقِ"},{"id":5935,"surah":86,"ayah":4,"text":"إِن كُلُّ نَفْسٍۢ لَّمَّا عَلَيْهَا حَافِظٌۭ","translation":"Il n'est pas d'âme qui n'ait sur elle un gardien.","juz":30,"page":591,"surahName":"At-Taariq","surahNameAr":"سُورَةُ الطَّارِقِ"},{"id":5936,"surah":86,"ayah":5,"text":"فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ","translation":"Que l'homme considère donc de quoi il a été créé.","juz":30,"page":591,"surahName":"At-Taariq","surahNameAr":"سُورَةُ الطَّارِقِ"},{"id":5937,"surah":86,"ayah":6,"text":"خُلِقَ مِن مَّآءٍۢ دَافِقٍۢ","translation":"Il a été créé d'une giclée d'eau","juz":30,"page":591,"surahName":"At-Taariq","surahNameAr":"سُورَةُ الطَّارِقِ"},{"id":5938,"surah":86,"ayah":7,"text":"يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ","translation":"sortie d'entre les lombes et les côtes.","juz":30,"page":591,"surahName":"At-Taariq","surahNameAr":"سُورَةُ الطَّارِقِ"},{"id":5939,"surah":86,"ayah":8,"text":"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌۭ","translation":"Allah est certes capable de le ressusciter.","juz":30,"page":591,"surahName":"At-Taariq","surahNameAr":"سُورَةُ الطَّارِقِ"},{"id":5940,"surah":86,"ayah":9,"text":"يَوْمَ تُبْلَى ٱلسَّرَآئِرُ","translation":"Le jour où les cœurs dévoileront leurs secrets,","juz":30,"page":591,"surahName":"At-Taariq","surahNameAr":"سُورَةُ الطَّارِقِ"},{"id":5941,"surah":86,"ayah":10,"text":"فَمَا لَهُۥ مِن قُوَّةٍۢ وَلَا نَاصِرٍۢ","translation":"Il n'aura alors ni force ni secoureur.","juz":30,"page":591,"surahName":"At-Taariq","surahNameAr":"سُورَةُ الطَّارِقِ"},{"id":5942,"surah":86,"ayah":11,"text":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ","translation":"Par le ciel qui fait revenir la pluie!","juz":30,"page":591,"surahName":"At-Taariq","surahNameAr":"سُورَةُ الطَّارِقِ"},{"id":5943,"surah":86,"ayah":12,"text":"وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ","translation":"et par la terre qui se fend!","juz":30,"page":591,"surahName":"At-Taariq","surahNameAr":"سُورَةُ الطَّارِقِ"},{"id":5944,"surah":86,"ayah":13,"text":"إِنَّهُۥ لَقَوْلٌۭ فَصْلٌۭ","translation":"Ceci [le Coran] est certes, une parole décisive [qui tranche entre le vrai et le faux],","juz":30,"page":591,"surahName":"At-Taariq","surahNameAr":"سُورَةُ الطَّارِقِ"},{"id":5945,"surah":86,"ayah":14,"text":"وَمَا هُوَ بِٱلْهَزْلِ","translation":"et non point une plaisanterie frivole!","juz":30,"page":591,"surahName":"At-Taariq","surahNameAr":"سُورَةُ الطَّارِقِ"},{"id":5946,"surah":86,"ayah":15,"text":"إِنَّهُمْ يَكِيدُونَ كَيْدًۭا","translation":"Ils se servent d'une ruse,","juz":30,"page":591,"surahName":"At-Taariq","surahNameAr":"سُورَةُ الطَّارِقِ"},{"id":5947,"surah":86,"ayah":16,"text":"وَأَكِيدُ كَيْدًۭا","translation":"et Moi aussi Je me sers de Mon plan.","juz":30,"page":591,"surahName":"At-Taariq","surahNameAr":"سُورَةُ الطَّارِقِ"},{"id":5948,"surah":86,"ayah":17,"text":"فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا","translation":"Accorde (ô Prophète) donc un délai aux infidèles: accorde-leur un court délai.","juz":30,"page":591,"surahName":"At-Taariq","surahNameAr":"سُورَةُ الطَّارِقِ"},{"id":5949,"surah":87,"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى","translation":"Glorifie le nom de ton Seigneur, le Très Haut,","juz":30,"page":591,"surahName":"Al-A'laa","surahNameAr":"سُورَةُ الأَعۡلَىٰ"},{"id":5950,"surah":87,"ayah":2,"text":"ٱلَّذِى خَلَقَ فَسَوَّىٰ","translation":"Celui Qui a créé et agencé harmonieusement,","juz":30,"page":591,"surahName":"Al-A'laa","surahNameAr":"سُورَةُ الأَعۡلَىٰ"},{"id":5951,"surah":87,"ayah":3,"text":"وَٱلَّذِى قَدَّرَ فَهَدَىٰ","translation":"qui a décrété et guidé,","juz":30,"page":591,"surahName":"Al-A'laa","surahNameAr":"سُورَةُ الأَعۡلَىٰ"},{"id":5952,"surah":87,"ayah":4,"text":"وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ","translation":"et qui a fait pousser le pâturage,","juz":30,"page":591,"surahName":"Al-A'laa","surahNameAr":"سُورَةُ الأَعۡلَىٰ"},{"id":5953,"surah":87,"ayah":5,"text":"فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ","translation":"et en a fait ensuite un foin sombre.","juz":30,"page":591,"surahName":"Al-A'laa","surahNameAr":"سُورَةُ الأَعۡلَىٰ"},{"id":5954,"surah":87,"ayah":6,"text":"سَنُقْرِئُكَ فَلَا تَنسَىٰٓ","translation":"Nous te ferons réciter (le Coran), de sorte que tu n'oublieras","juz":30,"page":591,"surahName":"Al-A'laa","surahNameAr":"سُورَةُ الأَعۡلَىٰ"},{"id":5955,"surah":87,"ayah":7,"text":"إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ","translation":"que ce qu'Allah veut. Car, Il connaît ce qui paraît au grand jour ainsi que ce qui est caché.","juz":30,"page":591,"surahName":"Al-A'laa","surahNameAr":"سُورَةُ الأَعۡلَىٰ"},{"id":5956,"surah":87,"ayah":8,"text":"وَنُيَسِّرُكَ لِلْيُسْرَىٰ","translation":"Nous te mettrons sur la voie la plus facile.","juz":30,"page":591,"surahName":"Al-A'laa","surahNameAr":"سُورَةُ الأَعۡلَىٰ"},{"id":5957,"surah":87,"ayah":9,"text":"فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ","translation":"Rappelle, donc, où le Rappel doit être utile.","juz":30,"page":591,"surahName":"Al-A'laa","surahNameAr":"سُورَةُ الأَعۡلَىٰ"},{"id":5958,"surah":87,"ayah":10,"text":"سَيَذَّكَّرُ مَن يَخْشَىٰ","translation":"Quiconque craint (Allah) s'[en] rappellera,","juz":30,"page":591,"surahName":"Al-A'laa","surahNameAr":"سُورَةُ الأَعۡلَىٰ"},{"id":5959,"surah":87,"ayah":11,"text":"وَيَتَجَنَّبُهَا ٱلْأَشْقَى","translation":"et s'en écartera le grand malheureux,","juz":30,"page":591,"surahName":"Al-A'laa","surahNameAr":"سُورَةُ الأَعۡلَىٰ"},{"id":5960,"surah":87,"ayah":12,"text":"ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ","translation":"qui brûlera dans le plus grand Feu,","juz":30,"page":591,"surahName":"Al-A'laa","surahNameAr":"سُورَةُ الأَعۡلَىٰ"},{"id":5961,"surah":87,"ayah":13,"text":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ","translation":"où il ne mourra ni ne vivra.","juz":30,"page":591,"surahName":"Al-A'laa","surahNameAr":"سُورَةُ الأَعۡلَىٰ"},{"id":5962,"surah":87,"ayah":14,"text":"قَدْ أَفْلَحَ مَن تَزَكَّىٰ","translation":"Réussit, certes, celui qui se purifie,","juz":30,"page":591,"surahName":"Al-A'laa","surahNameAr":"سُورَةُ الأَعۡلَىٰ"},{"id":5963,"surah":87,"ayah":15,"text":"وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ","translation":"et se rappelle le nom de son Seigneur, puis célèbre la Salât.","juz":30,"page":591,"surahName":"Al-A'laa","surahNameAr":"سُورَةُ الأَعۡلَىٰ"}]