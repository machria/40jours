[{"id":6194,"surah":106,"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لِإِيلَٰفِ قُرَيْشٍ","translation":"A cause du pacte des Coraïch,","juz":30,"page":602,"surahName":"Quraish","surahNameAr":"سُورَةُ قُرَيۡشٍ"},{"id":6195,"surah":106,"ayah":2,"text":"إِۦلَٰفِهِمْ رِحْلَةَ ٱلشِّتَآءِ وَٱلصَّيْفِ","translation":"De leur pacte [concernant] les voyages d'hiver et d'été.","juz":30,"page":602,"surahName":"Quraish","surahNameAr":"سُورَةُ قُرَيۡشٍ"},{"id":6196,"surah":106,"ayah":3,"text":"فَلْيَعْبُدُوا۟ رَبَّ هَٰذَا ٱلْبَيْتِ","translation":"Qu'ils adorent donc le Seigneur de cette Maison [la Ka'ba],","juz":30,"page":602,"surahName":"Quraish","surahNameAr":"سُورَةُ قُرَيۡشٍ"},{"id":6197,"surah":106,"ayah":4,"text":"ٱلَّذِىٓ أَطْعَمَهُم مِّن جُوعٍۢ وَءَامَنَهُم مِّنْ خَوْفٍۭ","translation":"qui les a nourris contre la faim et rassurés de la crainte!","juz":30,"page":602,"surahName":"Quraish","surahNameAr":"سُورَةُ قُرَيۡشٍ"},{"id":6198,"surah":107,"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","translation":"Vois-tu celui qui traite de mensonge la Rétribution?","juz":30,"page":602,"surahName":"Al-Maa'un","surahNameAr":"سُورَةُ المَاعُونِ"},{"id":6199,"surah":107,"ayah":2,"text":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","translation":"C'est bien lui qui repousse l'orphelin,","juz":30,"page":602,"surahName":"Al-Maa'un","surahNameAr":"سُورَةُ المَاعُونِ"},{"id":6200,"surah":107,"ayah":3,"text":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","translation":"et qui n'encourage point à nourrir le pauvre.","juz":30,"page":602,"surahName":"Al-Maa'un","surahNameAr":"سُورَةُ المَاعُونِ"},{"id":6201,"surah":107,"ayah":4,"text":"فَوَيْلٌۭ لِّلْمُصَلِّينَ","translation":"Malheur donc, à ceux qui prient","juz":30,"page":602,"surahName":"Al-Maa'un","surahNameAr":"سُورَةُ المَاعُونِ"},{"id":6202,"surah":107,"ayah":5,"text":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","translation":"tout en négligeant (et retardant) leur Salât,","juz":30,"page":602,"surahName":"Al-Maa'un","surahNameAr":"سُورَةُ المَاعُونِ"},{"id":6203,"surah":107,"ayah":6,"text":"ٱلَّذِينَ هُمْ يُرَآءُونَ","translation":"qui sont pleins d'ostentation,","juz":30,"page":602,"surahName":"Al-Maa'un","surahNameAr":"سُورَةُ المَاعُونِ"},{"id":6204,"surah":107,"ayah":7,"text":"وَيَمْنَعُونَ ٱلْمَاعُونَ","translation":"et refusent l'ustensile (à celui qui en a besoin).","juz":30,"page":602,"surahName":"Al-Maa'un","surahNameAr":"سُورَةُ المَاعُونِ"},{"id":6205,"surah":108,"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِنَّآ أَعْطَيْنَٰكَ ٱلْكَوْثَرَ","translation":"Nous t'avons certes, accordé l'Abondance.","juz":30,"page":602,"surahName":"Al-Kawthar","surahNameAr":"سُورَةُ الكَوۡثَرِ"},{"id":6206,"surah":108,"ayah":2,"text":"فَصَلِّ لِرَبِّكَ وَٱنْحَرْ","translation":"Accomplis la Salât pour ton Seigneur et sacrifie.","juz":30,"page":602,"surahName":"Al-Kawthar","surahNameAr":"سُورَةُ الكَوۡثَرِ"},{"id":6207,"surah":108,"ayah":3,"text":"إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ","translation":"Celui qui te hait sera certes, sans postérité.","juz":30,"page":602,"surahName":"Al-Kawthar","surahNameAr":"سُورَةُ الكَوۡثَرِ"}]