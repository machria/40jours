                    "name": "Ahmad Muhammad Shakir",
                    "grade": "Hasan"
                },
                {
                    "name": "Al-Albani",
                    "grade": "Hasan"
                },
                {
                    "name": "Bashar Awad Maarouf",
                    "grade": "Hasan"
                },
                {
                    "name": "Zubair Ali Zai",
                    "grade": "Hasan"
