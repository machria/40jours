[{"id":4996,"surah":56,"ayah":17,"text":"يَطُوفُ عَلَيْهِمْ وِلْدَٰنٌۭ مُّخَلَّدُونَ","translation":"Parmi eux circuleront des garçons éternellement jeunes,","juz":27,"page":535,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":4997,"surah":56,"ayah":18,"text":"بِأَكْوَابٍۢ وَأَبَارِيقَ وَكَأْسٍۢ مِّن مَّعِينٍۢ","translation":"avec des coupes, des aiguières et un verre [rempli] d'une liqueur de source","juz":27,"page":535,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":4998,"surah":56,"ayah":19,"text":"لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزِفُونَ","translation":"qui ne leur provoquera ni maux de tête ni étourdissement;","juz":27,"page":535,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":4999,"surah":56,"ayah":20,"text":"وَفَٰكِهَةٍۢ مِّمَّا يَتَخَيَّرُونَ","translation":"et des fruits de leur choix,","juz":27,"page":535,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":5000,"surah":56,"ayah":21,"text":"وَلَحْمِ طَيْرٍۢ مِّمَّا يَشْتَهُونَ","translation":"et toute chair d'oiseau qu'ils désireront.","juz":27,"page":535,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":5001,"surah":56,"ayah":22,"text":"وَحُورٌ عِينٌۭ","translation":"Et ils auront des houris aux yeux, grands et beaux,","juz":27,"page":535,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":5002,"surah":56,"ayah":23,"text":"كَأَمْثَٰلِ ٱللُّؤْلُؤِ ٱلْمَكْنُونِ","translation":"pareilles à des perles en coquille","juz":27,"page":535,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":5003,"surah":56,"ayah":24,"text":"جَزَآءًۢ بِمَا كَانُوا۟ يَعْمَلُونَ","translation":"en récompense pour ce qu'ils faisaient.","juz":27,"page":535,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":5004,"surah":56,"ayah":25,"text":"لَا يَسْمَعُونَ فِيهَا لَغْوًۭا وَلَا تَأْثِيمًا","translation":"Ils n'y entendront ni futilité ni blasphème;","juz":27,"page":535,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":5005,"surah":56,"ayah":26,"text":"إِلَّا قِيلًۭا سَلَٰمًۭا سَلَٰمًۭا","translation":"mais seulement les propos: «Salâm! Salâm!»... [Paix! Paix!]","juz":27,"page":535,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":5006,"surah":56,"ayah":27,"text":"وَأَصْحَٰبُ ٱلْيَمِينِ مَآ أَصْحَٰبُ ٱلْيَمِينِ","translation":"Et les gens de la droite; que sont les gens de la droite?","juz":27,"page":535,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":5007,"surah":56,"ayah":28,"text":"فِى سِدْرٍۢ مَّخْضُودٍۢ","translation":"[Ils seront parmi] des jujubiers sans épines,","juz":27,"page":535,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":5008,"surah":56,"ayah":29,"text":"وَطَلْحٍۢ مَّنضُودٍۢ","translation":"et parmi des bananiers aux régimes bien fournis,","juz":27,"page":535,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":5009,"surah":56,"ayah":30,"text":"وَظِلٍّۢ مَّمْدُودٍۢ","translation":"dans une ombre étendue","juz":27,"page":535,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":5010,"surah":56,"ayah":31,"text":"وَمَآءٍۢ مَّسْكُوبٍۢ","translation":"[près] d'une eau coulant continuellement,","juz":27,"page":535,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":5011,"surah":56,"ayah":32,"text":"وَفَٰكِهَةٍۢ كَثِيرَةٍۢ","translation":"et des fruits abondants","juz":27,"page":535,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":5012,"surah":56,"ayah":33,"text":"لَّا مَقْطُوعَةٍۢ وَلَا مَمْنُوعَةٍۢ","translation":"ni interrompus ni défendus,","juz":27,"page":535,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":5013,"surah":56,"ayah":34,"text":"وَفُرُشٍۢ مَّرْفُوعَةٍ","translation":"sur des lits surélevés,","juz":27,"page":535,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":5014,"surah":56,"ayah":35,"text":"إِنَّآ أَنشَأْنَٰهُنَّ إِنشَآءًۭ","translation":"C'est Nous qui les avons créées à la perfection,","juz":27,"page":535,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":5015,"surah":56,"ayah":36,"text":"فَجَعَلْنَٰهُنَّ أَبْكَارًا","translation":"et Nous les avons faites vierges,","juz":27,"page":535,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":5016,"surah":56,"ayah":37,"text":"عُرُبًا أَتْرَابًۭا","translation":"gracieuses, toutes de même âge,","juz":27,"page":535,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":5017,"surah":56,"ayah":38,"text":"لِّأَصْحَٰبِ ٱلْيَمِينِ","translation":"pour les gens de la droite,","juz":27,"page":535,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":5018,"surah":56,"ayah":39,"text":"ثُلَّةٌۭ مِّنَ ٱلْأَوَّلِينَ","translation":"une multitude d'élus parmi les premières [générations],","juz":27,"page":535,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":5019,"surah":56,"ayah":40,"text":"وَثُلَّةٌۭ مِّنَ ٱلْءَاخِرِينَ","translation":"et une multitude d'élus parmi les dernières [générations].","juz":27,"page":535,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":5020,"surah":56,"ayah":41,"text":"وَأَصْحَٰبُ ٱلشِّمَالِ مَآ أَصْحَٰبُ ٱلشِّمَالِ","translation":"Et les gens de la gauche; que sont les gens de la gauche?","juz":27,"page":535,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":5021,"surah":56,"ayah":42,"text":"فِى سَمُومٍۢ وَحَمِيمٍۢ","translation":"ils seront au milieu d'un souffle brûlant et d'une eau bouillante,","juz":27,"page":535,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":5022,"surah":56,"ayah":43,"text":"وَظِلٍّۢ مِّن يَحْمُومٍۢ","translation":"à l'ombre d'une fumée noire","juz":27,"page":535,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":5023,"surah":56,"ayah":44,"text":"لَّا بَارِدٍۢ وَلَا كَرِيمٍ","translation":"ni fraîche, ni douce.","juz":27,"page":535,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":5024,"surah":56,"ayah":45,"text":"إِنَّهُمْ كَانُوا۟ قَبْلَ ذَٰلِكَ مُتْرَفِينَ","translation":"Ils vivaient auparavant dans le luxe.","juz":27,"page":535,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":5025,"surah":56,"ayah":46,"text":"وَكَانُوا۟ يُصِرُّونَ عَلَى ٱلْحِنثِ ٱلْعَظِيمِ","translation":"Ils persistaient dans le grand péché [le polythéisme]","juz":27,"page":535,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":5026,"surah":56,"ayah":47,"text":"وَكَانُوا۟ يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَابًۭا وَعِظَٰمًا أَءِنَّا لَمَبْعُوثُونَ","translation":"et disaient: «Quand nous mourrons et serons poussière et ossements, serons-nous ressuscités?","juz":27,"page":535,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":5027,"surah":56,"ayah":48,"text":"أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ","translation":"ainsi que nos anciens ancêtres?..»","juz":27,"page":535,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":5028,"surah":56,"ayah":49,"text":"قُلْ إِنَّ ٱلْأَوَّلِينَ وَٱلْءَاخِرِينَ","translation":"Dis: «En vérité les premiers et les derniers","juz":27,"page":535,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"},{"id":5029,"surah":56,"ayah":50,"text":"لَمَجْمُوعُونَ إِلَىٰ مِيقَٰتِ يَوْمٍۢ مَّعْلُومٍۢ","translation":"seront réunis pour le rendez-vous d'un jour connu».","juz":27,"page":535,"surahName":"Al-Waaqia","surahNameAr":"سُورَةُ الوَاقِعَةِ"}]