[{"id":3891,"surah":37,"ayah":103,"text":"فَلَمَّآ أَسْلَمَا وَتَلَّهُۥ لِلْجَبِينِ","translation":"Puis quand tous deux se furent soumis (à l'ordre d'Allah) et qu'il l'eut jeté sur le front,","juz":23,"page":450,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3892,"surah":37,"ayah":104,"text":"وَنَٰدَيْنَٰهُ أَن يَٰٓإِبْرَٰهِيمُ","translation":"voilà que Nous l'appelâmes «Abraham!","juz":23,"page":450,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3893,"surah":37,"ayah":105,"text":"قَدْ صَدَّقْتَ ٱلرُّءْيَآ ۚ إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ","translation":"Tu as confirmé la vision. C'est ainsi que Nous récompensons les bienfaisants».","juz":23,"page":450,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3894,"surah":37,"ayah":106,"text":"إِنَّ هَٰذَا لَهُوَ ٱلْبَلَٰٓؤُا۟ ٱلْمُبِينُ","translation":"C'était là certes, l'épreuve manifeste.","juz":23,"page":450,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3895,"surah":37,"ayah":107,"text":"وَفَدَيْنَٰهُ بِذِبْحٍ عَظِيمٍۢ","translation":"Et Nous le rançonnâmes d'une immolation généreuse.","juz":23,"page":450,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3896,"surah":37,"ayah":108,"text":"وَتَرَكْنَا عَلَيْهِ فِى ٱلْءَاخِرِينَ","translation":"Et Nous perpétuâmes son renom dans la postérité:","juz":23,"page":450,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3897,"surah":37,"ayah":109,"text":"سَلَٰمٌ عَلَىٰٓ إِبْرَٰهِيمَ","translation":"«Paix sur Abraham».","juz":23,"page":450,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3898,"surah":37,"ayah":110,"text":"كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ","translation":"Ainsi récompensons-Nous les bienfaisants;","juz":23,"page":450,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3899,"surah":37,"ayah":111,"text":"إِنَّهُۥ مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ","translation":"car il était de Nos serviteurs croyants.","juz":23,"page":450,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3900,"surah":37,"ayah":112,"text":"وَبَشَّرْنَٰهُ بِإِسْحَٰقَ نَبِيًّۭا مِّنَ ٱلصَّٰلِحِينَ","translation":"Nous lui fîmes la bonne annonce d'Isaac comme prophète d'entre les gens vertueux.","juz":23,"page":450,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3901,"surah":37,"ayah":113,"text":"وَبَٰرَكْنَا عَلَيْهِ وَعَلَىٰٓ إِسْحَٰقَ ۚ وَمِن ذُرِّيَّتِهِمَا مُحْسِنٌۭ وَظَالِمٌۭ لِّنَفْسِهِۦ مُبِينٌۭ","translation":"Et Nous le bénîmes ainsi que Isaac. Parmi leurs descendances il y a [l'homme] de bien et celui qui est manifestement injuste envers lui-même.","juz":23,"page":450,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3902,"surah":37,"ayah":114,"text":"وَلَقَدْ مَنَنَّا عَلَىٰ مُوسَىٰ وَهَٰرُونَ","translation":"Et Nous accordâmes certes à Moïse et Aaron des faveurs,","juz":23,"page":450,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3903,"surah":37,"ayah":115,"text":"وَنَجَّيْنَٰهُمَا وَقَوْمَهُمَا مِنَ ٱلْكَرْبِ ٱلْعَظِيمِ","translation":"Et les sauvâmes ainsi que leur peuple, de la grande angoisse,","juz":23,"page":450,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3904,"surah":37,"ayah":116,"text":"وَنَصَرْنَٰهُمْ فَكَانُوا۟ هُمُ ٱلْغَٰلِبِينَ","translation":"et les secourûmes, et ils furent eux les vainqueurs.","juz":23,"page":450,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3905,"surah":37,"ayah":117,"text":"وَءَاتَيْنَٰهُمَا ٱلْكِتَٰبَ ٱلْمُسْتَبِينَ","translation":"Et Nous leur apportâmes le livre explicite","juz":23,"page":450,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3906,"surah":37,"ayah":118,"text":"وَهَدَيْنَٰهُمَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ","translation":"et les guidâmes vers le droit chemin.","juz":23,"page":450,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3907,"surah":37,"ayah":119,"text":"وَتَرَكْنَا عَلَيْهِمَا فِى ٱلْءَاخِرِينَ","translation":"Et Nous perpétuâmes leur renom dans la postérité:","juz":23,"page":450,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3908,"surah":37,"ayah":120,"text":"سَلَٰمٌ عَلَىٰ مُوسَىٰ وَهَٰرُونَ","translation":"«Paix sur Moïse et Aaron»","juz":23,"page":450,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3909,"surah":37,"ayah":121,"text":"إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ","translation":"Ainsi récompensons-Nous les bienfaisants;","juz":23,"page":450,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3910,"surah":37,"ayah":122,"text":"إِنَّهُمَا مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ","translation":"car ils étaient du nombre de Nos serviteurs croyants.","juz":23,"page":450,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3911,"surah":37,"ayah":123,"text":"وَإِنَّ إِلْيَاسَ لَمِنَ ٱلْمُرْسَلِينَ","translation":"Elie était, certes, du nombre des Messagers.","juz":23,"page":450,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3912,"surah":37,"ayah":124,"text":"إِذْ قَالَ لِقَوْمِهِۦٓ أَلَا تَتَّقُونَ","translation":"Quand il dit à son peuple: «Ne craignez-vous pas [Allah]?»","juz":23,"page":450,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3913,"surah":37,"ayah":125,"text":"أَتَدْعُونَ بَعْلًۭا وَتَذَرُونَ أَحْسَنَ ٱلْخَٰلِقِينَ","translation":"Invoquerez-vous Ball (une idole) et délaisserez-vous le Meilleur des créateurs,","juz":23,"page":450,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"},{"id":3914,"surah":37,"ayah":126,"text":"ٱللَّهَ رَبَّكُمْ وَرَبَّ ءَابَآئِكُمُ ٱلْأَوَّلِينَ","translation":"Allah, votre Seigneur et le Seigneur de vos plus anciens ancêtres?»","juz":23,"page":450,"surahName":"As-Saaffaat","surahNameAr":"سُورَةُ الصَّافَّاتِ"}]