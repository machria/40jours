[{"id":6099,"surah":95,"ayah":1,"text":"بِّسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلتِّينِ وَٱلزَّيْتُونِ","translation":"Par le figuier et l'olivier!","juz":30,"page":597,"surahName":"At-Tin","surahNameAr":"سُورَةُ التِّينِ"},{"id":6100,"surah":95,"ayah":2,"text":"وَطُورِ سِينِينَ","translation":"Et par le Mont Sînîn!","juz":30,"page":597,"surahName":"At-Tin","surahNameAr":"سُورَةُ التِّينِ"},{"id":6101,"surah":95,"ayah":3,"text":"وَهَٰذَا ٱلْبَلَدِ ٱلْأَمِينِ","translation":"Et par cette Cité sûre!","juz":30,"page":597,"surahName":"At-Tin","surahNameAr":"سُورَةُ التِّينِ"},{"id":6102,"surah":95,"ayah":4,"text":"لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِىٓ أَحْسَنِ تَقْوِيمٍۢ","translation":"Nous avons certes créé l'homme dans la forme la plus parfaite.","juz":30,"page":597,"surahName":"At-Tin","surahNameAr":"سُورَةُ التِّينِ"},{"id":6103,"surah":95,"ayah":5,"text":"ثُمَّ رَدَدْنَٰهُ أَسْفَلَ سَٰفِلِينَ","translation":"Ensuite, Nous l'avons ramené au niveau le plus bas,","juz":30,"page":597,"surahName":"At-Tin","surahNameAr":"سُورَةُ التِّينِ"},{"id":6104,"surah":95,"ayah":6,"text":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۢ","translation":"sauf ceux qui croient et accomplissent les bonnes œuvres: ceux-là auront une récompense jamais interrompue.","juz":30,"page":597,"surahName":"At-Tin","surahNameAr":"سُورَةُ التِّينِ"},{"id":6105,"surah":95,"ayah":7,"text":"فَمَا يُكَذِّبُكَ بَعْدُ بِٱلدِّينِ","translation":"Après cela, qu'est-ce qui te fait traiter la rétribution de mensonge?","juz":30,"page":597,"surahName":"At-Tin","surahNameAr":"سُورَةُ التِّينِ"},{"id":6106,"surah":95,"ayah":8,"text":"أَلَيْسَ ٱللَّهُ بِأَحْكَمِ ٱلْحَٰكِمِينَ","translation":"Allah n'est-Il pas le plus sage des Juges?","juz":30,"page":597,"surahName":"At-Tin","surahNameAr":"سُورَةُ التِّينِ"},{"id":6107,"surah":96,"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ","translation":"Lis, au nom de ton Seigneur qui a créé,","juz":30,"page":597,"surahName":"Al-Alaq","surahNameAr":"سُورَةُ العَلَقِ"},{"id":6108,"surah":96,"ayah":2,"text":"خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ","translation":"qui a créé l'homme d'une adhérence.","juz":30,"page":597,"surahName":"Al-Alaq","surahNameAr":"سُورَةُ العَلَقِ"},{"id":6109,"surah":96,"ayah":3,"text":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ","translation":"Lis! Ton Seigneur est le Très Noble,","juz":30,"page":597,"surahName":"Al-Alaq","surahNameAr":"سُورَةُ العَلَقِ"},{"id":6110,"surah":96,"ayah":4,"text":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ","translation":"qui a enseigné par la plume [le calame],","juz":30,"page":597,"surahName":"Al-Alaq","surahNameAr":"سُورَةُ العَلَقِ"},{"id":6111,"surah":96,"ayah":5,"text":"عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ","translation":"a enseigné à l'homme ce qu'il ne savait pas.","juz":30,"page":597,"surahName":"Al-Alaq","surahNameAr":"سُورَةُ العَلَقِ"},{"id":6112,"surah":96,"ayah":6,"text":"كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ","translation":"Prenez-garde! Vraiment l'homme devient rebelle,","juz":30,"page":597,"surahName":"Al-Alaq","surahNameAr":"سُورَةُ العَلَقِ"},{"id":6113,"surah":96,"ayah":7,"text":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ","translation":"dès qu'il estime qu'il peut se suffire à lui-même (à cause de sa richesse).","juz":30,"page":597,"surahName":"Al-Alaq","surahNameAr":"سُورَةُ العَلَقِ"},{"id":6114,"surah":96,"ayah":8,"text":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ","translation":"Mais, c'est vers ton Seigneur qu'est le retour.","juz":30,"page":597,"surahName":"Al-Alaq","surahNameAr":"سُورَةُ العَلَقِ"},{"id":6115,"surah":96,"ayah":9,"text":"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ","translation":"As-tu vu celui qui interdit","juz":30,"page":597,"surahName":"Al-Alaq","surahNameAr":"سُورَةُ العَلَقِ"},{"id":6116,"surah":96,"ayah":10,"text":"عَبْدًا إِذَا صَلَّىٰٓ","translation":"à un serviteur d'Allah [Muhammad] de célébrer la Salât?","juz":30,"page":597,"surahName":"Al-Alaq","surahNameAr":"سُورَةُ العَلَقِ"},{"id":6117,"surah":96,"ayah":11,"text":"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ","translation":"Vois-tu s'il est sur la bonne voie,","juz":30,"page":597,"surahName":"Al-Alaq","surahNameAr":"سُورَةُ العَلَقِ"},{"id":6118,"surah":96,"ayah":12,"text":"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ","translation":"ou s'il ordonne la piété?","juz":30,"page":597,"surahName":"Al-Alaq","surahNameAr":"سُورَةُ العَلَقِ"},{"id":6119,"surah":96,"ayah":13,"text":"أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","translation":"Vois-tu s'il dément et tourne le dos?","juz":30,"page":597,"surahName":"Al-Alaq","surahNameAr":"سُورَةُ العَلَقِ"},{"id":6120,"surah":96,"ayah":14,"text":"أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ","translation":"Ne sait-il pas que vraiment Allah voit?","juz":30,"page":597,"surahName":"Al-Alaq","surahNameAr":"سُورَةُ العَلَقِ"},{"id":6121,"surah":96,"ayah":15,"text":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ","translation":"Mais non! S'il ne cesse pas, Nous le saisirons certes, par le toupet,","juz":30,"page":597,"surahName":"Al-Alaq","surahNameAr":"سُورَةُ العَلَقِ"},{"id":6122,"surah":96,"ayah":16,"text":"نَاصِيَةٍۢ كَٰذِبَةٍ خَاطِئَةٍۢ","translation":"le toupet d'un menteur, d'un pécheur.","juz":30,"page":597,"surahName":"Al-Alaq","surahNameAr":"سُورَةُ العَلَقِ"},{"id":6123,"surah":96,"ayah":17,"text":"فَلْيَدْعُ نَادِيَهُۥ","translation":"Qu'il appelle donc son assemblée.","juz":30,"page":597,"surahName":"Al-Alaq","surahNameAr":"سُورَةُ العَلَقِ"},{"id":6124,"surah":96,"ayah":18,"text":"سَنَدْعُ ٱلزَّبَانِيَةَ","translation":"Nous appellerons les gardiens [de l'Enfer].","juz":30,"page":597,"surahName":"Al-Alaq","surahNameAr":"سُورَةُ العَلَقِ"},{"id":6125,"surah":96,"ayah":19,"text":"كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩","translation":"Non! Ne lui obéis pas; mais prosterne-toi et rapproche-toi.","juz":30,"page":597,"surahName":"Al-Alaq","surahNameAr":"سُورَةُ العَلَقِ"}]