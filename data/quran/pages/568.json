[{"id":5358,"surah":69,"ayah":35,"text":"فَلَيْسَ لَهُ ٱلْيَوْمَ هَٰهُنَا حَمِيمٌۭ","translation":"Il n'a pour lui ici, aujourd'hui, point d'ami chaleureux [pour le protéger],","juz":29,"page":568,"surahName":"Al-Haaqqa","surahNameAr":"سُورَةُ الحَاقَّةِ"},{"id":5359,"surah":69,"ayah":36,"text":"وَلَا طَعَامٌ إِلَّا مِنْ غِسْلِينٍۢ","translation":"ni d'autre nourriture que du pus,","juz":29,"page":568,"surahName":"Al-Haaqqa","surahNameAr":"سُورَةُ الحَاقَّةِ"},{"id":5360,"surah":69,"ayah":37,"text":"لَّا يَأْكُلُهُۥٓ إِلَّا ٱلْخَٰطِـُٔونَ","translation":"que seuls les fautifs mangeront».","juz":29,"page":568,"surahName":"Al-Haaqqa","surahNameAr":"سُورَةُ الحَاقَّةِ"},{"id":5361,"surah":69,"ayah":38,"text":"فَلَآ أُقْسِمُ بِمَا تُبْصِرُونَ","translation":"Mais non... Je jure par ce que vous voyez,","juz":29,"page":568,"surahName":"Al-Haaqqa","surahNameAr":"سُورَةُ الحَاقَّةِ"},{"id":5362,"surah":69,"ayah":39,"text":"وَمَا لَا تُبْصِرُونَ","translation":"ainsi que par ce que vous ne voyez pas,","juz":29,"page":568,"surahName":"Al-Haaqqa","surahNameAr":"سُورَةُ الحَاقَّةِ"},{"id":5363,"surah":69,"ayah":40,"text":"إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ","translation":"que ceci [le Coran] est la parole d'un noble Messager,","juz":29,"page":568,"surahName":"Al-Haaqqa","surahNameAr":"سُورَةُ الحَاقَّةِ"},{"id":5364,"surah":69,"ayah":41,"text":"وَمَا هُوَ بِقَوْلِ شَاعِرٍۢ ۚ قَلِيلًۭا مَّا تُؤْمِنُونَ","translation":"et que ce n'est pas la parole d'un poète; mais vous ne croyez que très peu,","juz":29,"page":568,"surahName":"Al-Haaqqa","surahNameAr":"سُورَةُ الحَاقَّةِ"},{"id":5365,"surah":69,"ayah":42,"text":"وَلَا بِقَوْلِ كَاهِنٍۢ ۚ قَلِيلًۭا مَّا تَذَكَّرُونَ","translation":"ni la parole d'un devin, mais vous vous rappelez bien peu.","juz":29,"page":568,"surahName":"Al-Haaqqa","surahNameAr":"سُورَةُ الحَاقَّةِ"},{"id":5366,"surah":69,"ayah":43,"text":"تَنزِيلٌۭ مِّن رَّبِّ ٱلْعَٰلَمِينَ","translation":"C'est une révélation du Seigneur de l'Univers.","juz":29,"page":568,"surahName":"Al-Haaqqa","surahNameAr":"سُورَةُ الحَاقَّةِ"},{"id":5367,"surah":69,"ayah":44,"text":"وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ ٱلْأَقَاوِيلِ","translation":"Et s'il avait forgé quelques paroles qu'ils Nous avait attribuées,","juz":29,"page":568,"surahName":"Al-Haaqqa","surahNameAr":"سُورَةُ الحَاقَّةِ"},{"id":5368,"surah":69,"ayah":45,"text":"لَأَخَذْنَا مِنْهُ بِٱلْيَمِينِ","translation":"Nous l'aurions saisi de la main droite,","juz":29,"page":568,"surahName":"Al-Haaqqa","surahNameAr":"سُورَةُ الحَاقَّةِ"},{"id":5369,"surah":69,"ayah":46,"text":"ثُمَّ لَقَطَعْنَا مِنْهُ ٱلْوَتِينَ","translation":"ensuite, Nous lui aurions tranché l'aorte.","juz":29,"page":568,"surahName":"Al-Haaqqa","surahNameAr":"سُورَةُ الحَاقَّةِ"},{"id":5370,"surah":69,"ayah":47,"text":"فَمَا مِنكُم مِّنْ أَحَدٍ عَنْهُ حَٰجِزِينَ","translation":"Et nul d'entre vous n'aurait pu lui servir de rempart.","juz":29,"page":568,"surahName":"Al-Haaqqa","surahNameAr":"سُورَةُ الحَاقَّةِ"},{"id":5371,"surah":69,"ayah":48,"text":"وَإِنَّهُۥ لَتَذْكِرَةٌۭ لِّلْمُتَّقِينَ","translation":"C'est en vérité un rappel pour les pieux.","juz":29,"page":568,"surahName":"Al-Haaqqa","surahNameAr":"سُورَةُ الحَاقَّةِ"},{"id":5372,"surah":69,"ayah":49,"text":"وَإِنَّا لَنَعْلَمُ أَنَّ مِنكُم مُّكَذِّبِينَ","translation":"Et Nous savons qu'il y a parmi vous qui le traitent de menteur;","juz":29,"page":568,"surahName":"Al-Haaqqa","surahNameAr":"سُورَةُ الحَاقَّةِ"},{"id":5373,"surah":69,"ayah":50,"text":"وَإِنَّهُۥ لَحَسْرَةٌ عَلَى ٱلْكَٰفِرِينَ","translation":"mais en vérité, ce sera un sujet de regret pour les mécréants,","juz":29,"page":568,"surahName":"Al-Haaqqa","surahNameAr":"سُورَةُ الحَاقَّةِ"},{"id":5374,"surah":69,"ayah":51,"text":"وَإِنَّهُۥ لَحَقُّ ٱلْيَقِينِ","translation":"c'est là la véritable certitude.","juz":29,"page":568,"surahName":"Al-Haaqqa","surahNameAr":"سُورَةُ الحَاقَّةِ"},{"id":5375,"surah":69,"ayah":52,"text":"فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ","translation":"Glorifie donc le nom de ton Seigneur, le Très Grand!","juz":29,"page":568,"surahName":"Al-Haaqqa","surahNameAr":"سُورَةُ الحَاقَّةِ"},{"id":5376,"surah":70,"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ سَأَلَ سَآئِلٌۢ بِعَذَابٍۢ وَاقِعٍۢ","translation":"Un demandeur a réclamé un châtiment inéluctable,","juz":29,"page":568,"surahName":"Al-Ma'aarij","surahNameAr":"سُورَةُ المَعَارِجِ"},{"id":5377,"surah":70,"ayah":2,"text":"لِّلْكَٰفِرِينَ لَيْسَ لَهُۥ دَافِعٌۭ","translation":"pour les mécréants, que nul ne pourrait repousser,","juz":29,"page":568,"surahName":"Al-Ma'aarij","surahNameAr":"سُورَةُ المَعَارِجِ"},{"id":5378,"surah":70,"ayah":3,"text":"مِّنَ ٱللَّهِ ذِى ٱلْمَعَارِجِ","translation":"et qui vient d'Allah, le Maître des voies d'ascension.","juz":29,"page":568,"surahName":"Al-Ma'aarij","surahNameAr":"سُورَةُ المَعَارِجِ"},{"id":5379,"surah":70,"ayah":4,"text":"تَعْرُجُ ٱلْمَلَٰٓئِكَةُ وَٱلرُّوحُ إِلَيْهِ فِى يَوْمٍۢ كَانَ مِقْدَارُهُۥ خَمْسِينَ أَلْفَ سَنَةٍۢ","translation":"Les Anges ainsi que l'Esprit montent vers Lui en un jour dont la durée est de cinquante mille ans.","juz":29,"page":568,"surahName":"Al-Ma'aarij","surahNameAr":"سُورَةُ المَعَارِجِ"},{"id":5380,"surah":70,"ayah":5,"text":"فَٱصْبِرْ صَبْرًۭا جَمِيلًا","translation":"Supporte donc, d'une belle patience.","juz":29,"page":568,"surahName":"Al-Ma'aarij","surahNameAr":"سُورَةُ المَعَارِجِ"},{"id":5381,"surah":70,"ayah":6,"text":"إِنَّهُمْ يَرَوْنَهُۥ بَعِيدًۭا","translation":"Ils le (le châtiment) voient bien loin,","juz":29,"page":568,"surahName":"Al-Ma'aarij","surahNameAr":"سُورَةُ المَعَارِجِ"},{"id":5382,"surah":70,"ayah":7,"text":"وَنَرَىٰهُ قَرِيبًۭا","translation":"alors que Nous le voyons bien proche,","juz":29,"page":568,"surahName":"Al-Ma'aarij","surahNameAr":"سُورَةُ المَعَارِجِ"},{"id":5383,"surah":70,"ayah":8,"text":"يَوْمَ تَكُونُ ٱلسَّمَآءُ كَٱلْمُهْلِ","translation":"le jour où le ciel sera comme du métal en fusion","juz":29,"page":568,"surahName":"Al-Ma'aarij","surahNameAr":"سُورَةُ المَعَارِجِ"},{"id":5384,"surah":70,"ayah":9,"text":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ","translation":"et les montagnes comme de la laine,","juz":29,"page":568,"surahName":"Al-Ma'aarij","surahNameAr":"سُورَةُ المَعَارِجِ"},{"id":5385,"surah":70,"ayah":10,"text":"وَلَا يَسْـَٔلُ حَمِيمٌ حَمِيمًۭا","translation":"où nul ami dévoué ne s'enquerra d'un ami,","juz":29,"page":568,"surahName":"Al-Ma'aarij","surahNameAr":"سُورَةُ المَعَارِجِ"}]