[{"id":6017,"surah":89,"ayah":24,"text":"يَقُولُ يَٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى","translation":"Il dira: «Hélas! Que n'ai-je fait du bien pour ma vie future!","juz":30,"page":594,"surahName":"Al-Fajr","surahNameAr":"سُورَةُ الفَجۡرِ"},{"id":6018,"surah":89,"ayah":25,"text":"فَيَوْمَئِذٍۢ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌۭ","translation":"Ce jour-là donc, nul ne saura châtier comme Lui châtie,","juz":30,"page":594,"surahName":"Al-Fajr","surahNameAr":"سُورَةُ الفَجۡرِ"},{"id":6019,"surah":89,"ayah":26,"text":"وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌۭ","translation":"et nul ne saura garrotter comme Lui garrotte.","juz":30,"page":594,"surahName":"Al-Fajr","surahNameAr":"سُورَةُ الفَجۡرِ"},{"id":6020,"surah":89,"ayah":27,"text":"يَٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ","translation":"«O toi, âme apaisée,","juz":30,"page":594,"surahName":"Al-Fajr","surahNameAr":"سُورَةُ الفَجۡرِ"},{"id":6021,"surah":89,"ayah":28,"text":"ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةًۭ مَّرْضِيَّةًۭ","translation":"retourne vers ton Seigneur, satisfaite et agréée;","juz":30,"page":594,"surahName":"Al-Fajr","surahNameAr":"سُورَةُ الفَجۡرِ"},{"id":6022,"surah":89,"ayah":29,"text":"فَٱدْخُلِى فِى عِبَٰدِى","translation":"entre donc parmi Mes serviteurs,","juz":30,"page":594,"surahName":"Al-Fajr","surahNameAr":"سُورَةُ الفَجۡرِ"},{"id":6023,"surah":89,"ayah":30,"text":"وَٱدْخُلِى جَنَّتِى","translation":"et entre dans Mon Paradis».","juz":30,"page":594,"surahName":"Al-Fajr","surahNameAr":"سُورَةُ الفَجۡرِ"},{"id":6024,"surah":90,"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِهَٰذَا ٱلْبَلَدِ","translation":"Non!... Je jure par cette Cité!","juz":30,"page":594,"surahName":"Al-Balad","surahNameAr":"سُورَةُ البَلَدِ"},{"id":6025,"surah":90,"ayah":2,"text":"وَأَنتَ حِلٌّۢ بِهَٰذَا ٱلْبَلَدِ","translation":"et toi, tu es un résident dans cette cité -","juz":30,"page":594,"surahName":"Al-Balad","surahNameAr":"سُورَةُ البَلَدِ"},{"id":6026,"surah":90,"ayah":3,"text":"وَوَالِدٍۢ وَمَا وَلَدَ","translation":"Et par le père et ce qu'il engendre!","juz":30,"page":594,"surahName":"Al-Balad","surahNameAr":"سُورَةُ البَلَدِ"},{"id":6027,"surah":90,"ayah":4,"text":"لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِى كَبَدٍ","translation":"Nous avons, certes, créé l'homme pour une vie de lutte.","juz":30,"page":594,"surahName":"Al-Balad","surahNameAr":"سُورَةُ البَلَدِ"},{"id":6028,"surah":90,"ayah":5,"text":"أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌۭ","translation":"Pense-t-il que personne ne pourra rien contre lui?","juz":30,"page":594,"surahName":"Al-Balad","surahNameAr":"سُورَةُ البَلَدِ"},{"id":6029,"surah":90,"ayah":6,"text":"يَقُولُ أَهْلَكْتُ مَالًۭا لُّبَدًا","translation":"Il dit: «J'ai gaspillé beaucoup de biens».","juz":30,"page":594,"surahName":"Al-Balad","surahNameAr":"سُورَةُ البَلَدِ"},{"id":6030,"surah":90,"ayah":7,"text":"أَيَحْسَبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌ","translation":"Pense-t-il que nul ne l'a vu?","juz":30,"page":594,"surahName":"Al-Balad","surahNameAr":"سُورَةُ البَلَدِ"},{"id":6031,"surah":90,"ayah":8,"text":"أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ","translation":"Ne lui avons Nous pas assigné deux yeux,","juz":30,"page":594,"surahName":"Al-Balad","surahNameAr":"سُورَةُ البَلَدِ"},{"id":6032,"surah":90,"ayah":9,"text":"وَلِسَانًۭا وَشَفَتَيْنِ","translation":"et une langue et deux lèvres?","juz":30,"page":594,"surahName":"Al-Balad","surahNameAr":"سُورَةُ البَلَدِ"},{"id":6033,"surah":90,"ayah":10,"text":"وَهَدَيْنَٰهُ ٱلنَّجْدَيْنِ","translation":"Ne l'avons-Nous pas guidé aux deux voies.","juz":30,"page":594,"surahName":"Al-Balad","surahNameAr":"سُورَةُ البَلَدِ"},{"id":6034,"surah":90,"ayah":11,"text":"فَلَا ٱقْتَحَمَ ٱلْعَقَبَةَ","translation":"Or, il ne s'engage pas dans la voie difficile!","juz":30,"page":594,"surahName":"Al-Balad","surahNameAr":"سُورَةُ البَلَدِ"},{"id":6035,"surah":90,"ayah":12,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلْعَقَبَةُ","translation":"Et qui te dira ce qu'est la voie difficile?","juz":30,"page":594,"surahName":"Al-Balad","surahNameAr":"سُورَةُ البَلَدِ"},{"id":6036,"surah":90,"ayah":13,"text":"فَكُّ رَقَبَةٍ","translation":"C'est délier un joug [affranchir un esclave],","juz":30,"page":594,"surahName":"Al-Balad","surahNameAr":"سُورَةُ البَلَدِ"},{"id":6037,"surah":90,"ayah":14,"text":"أَوْ إِطْعَٰمٌۭ فِى يَوْمٍۢ ذِى مَسْغَبَةٍۢ","translation":"ou nourrir, en un jour de famine,","juz":30,"page":594,"surahName":"Al-Balad","surahNameAr":"سُورَةُ البَلَدِ"},{"id":6038,"surah":90,"ayah":15,"text":"يَتِيمًۭا ذَا مَقْرَبَةٍ","translation":"un orphelin proche parent","juz":30,"page":594,"surahName":"Al-Balad","surahNameAr":"سُورَةُ البَلَدِ"},{"id":6039,"surah":90,"ayah":16,"text":"أَوْ مِسْكِينًۭا ذَا مَتْرَبَةٍۢ","translation":"ou un pauvre dans le dénuement.","juz":30,"page":594,"surahName":"Al-Balad","surahNameAr":"سُورَةُ البَلَدِ"},{"id":6040,"surah":90,"ayah":17,"text":"ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُوا۟ وَتَوَاصَوْا۟ بِٱلصَّبْرِ وَتَوَاصَوْا۟ بِٱلْمَرْحَمَةِ","translation":"Et c'est être, en outre, de ceux qui croient et s'enjoignent mutuellement l'endurance, et s'enjoignent mutuellement la miséricorde.","juz":30,"page":594,"surahName":"Al-Balad","surahNameAr":"سُورَةُ البَلَدِ"},{"id":6041,"surah":90,"ayah":18,"text":"أُو۟لَٰٓئِكَ أَصْحَٰبُ ٱلْمَيْمَنَةِ","translation":"Ceux-là sont les gens de la droite;","juz":30,"page":594,"surahName":"Al-Balad","surahNameAr":"سُورَةُ البَلَدِ"},{"id":6042,"surah":90,"ayah":19,"text":"وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَٰتِنَا هُمْ أَصْحَٰبُ ٱلْمَشْـَٔمَةِ","translation":"alors que ceux qui ne croient pas en Nos versets sont les gens de la gauche.","juz":30,"page":594,"surahName":"Al-Balad","surahNameAr":"سُورَةُ البَلَدِ"},{"id":6043,"surah":90,"ayah":20,"text":"عَلَيْهِمْ نَارٌۭ مُّؤْصَدَةٌۢ","translation":"Le Feu se refermera sur eux.","juz":30,"page":594,"surahName":"Al-Balad","surahNameAr":"سُورَةُ البَلَدِ"}]