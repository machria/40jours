[{"id":6156,"surah":100,"ayah":10,"text":"وَحُصِّلَ مَا فِى ٱلصُّدُورِ","translation":"et que sera dévoilé ce qui est dans les poitrines,","juz":30,"page":600,"surahName":"Al-Aadiyaat","surahNameAr":"سُورَةُ العَادِيَاتِ"},{"id":6157,"surah":100,"ayah":11,"text":"إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍۢ لَّخَبِيرٌۢ","translation":"ce jour-là, certes, leur Seigneur sera Parfaitement Connaisseur d'eux?","juz":30,"page":600,"surahName":"Al-Aadiyaat","surahNameAr":"سُورَةُ العَادِيَاتِ"},{"id":6158,"surah":101,"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلْقَارِعَةُ","translation":"Le fracas!","juz":30,"page":600,"surahName":"Al-Qaari'a","surahNameAr":"سُورَةُ القَارِعَةِ"},{"id":6159,"surah":101,"ayah":2,"text":"مَا ٱلْقَارِعَةُ","translation":"Qu'est-ce que le fracas?","juz":30,"page":600,"surahName":"Al-Qaari'a","surahNameAr":"سُورَةُ القَارِعَةِ"},{"id":6160,"surah":101,"ayah":3,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","translation":"Et qui te dira ce qu'est le fracas?","juz":30,"page":600,"surahName":"Al-Qaari'a","surahNameAr":"سُورَةُ القَارِعَةِ"},{"id":6161,"surah":101,"ayah":4,"text":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","translation":"C'est le jour où les gens seront comme des papillons éparpillés,","juz":30,"page":600,"surahName":"Al-Qaari'a","surahNameAr":"سُورَةُ القَارِعَةِ"},{"id":6162,"surah":101,"ayah":5,"text":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ","translation":"et les montagnes comme de la laine cardée;","juz":30,"page":600,"surahName":"Al-Qaari'a","surahNameAr":"سُورَةُ القَارِعَةِ"},{"id":6163,"surah":101,"ayah":6,"text":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","translation":"quant à celui dont la balance sera lourde","juz":30,"page":600,"surahName":"Al-Qaari'a","surahNameAr":"سُورَةُ القَارِعَةِ"},{"id":6164,"surah":101,"ayah":7,"text":"فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ","translation":"il sera dans une vie agréable;","juz":30,"page":600,"surahName":"Al-Qaari'a","surahNameAr":"سُورَةُ القَارِعَةِ"},{"id":6165,"surah":101,"ayah":8,"text":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ","translation":"et quant à celui dont la balance sera légère,","juz":30,"page":600,"surahName":"Al-Qaari'a","surahNameAr":"سُورَةُ القَارِعَةِ"},{"id":6166,"surah":101,"ayah":9,"text":"فَأُمُّهُۥ هَاوِيَةٌۭ","translation":"sa mère [destination] est un abîme très profond.","juz":30,"page":600,"surahName":"Al-Qaari'a","surahNameAr":"سُورَةُ القَارِعَةِ"},{"id":6167,"surah":101,"ayah":10,"text":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ","translation":"Et qui te dira ce que c'est?","juz":30,"page":600,"surahName":"Al-Qaari'a","surahNameAr":"سُورَةُ القَارِعَةِ"},{"id":6168,"surah":101,"ayah":11,"text":"نَارٌ حَامِيَةٌۢ","translation":"C'est un Feu ardent.","juz":30,"page":600,"surahName":"Al-Qaari'a","surahNameAr":"سُورَةُ القَارِعَةِ"},{"id":6169,"surah":102,"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلْهَىٰكُمُ ٱلتَّكَاثُرُ","translation":"La course aux richesses vous distrait,","juz":30,"page":600,"surahName":"At-Takaathur","surahNameAr":"سُورَةُ التَّكَاثُرِ"},{"id":6170,"surah":102,"ayah":2,"text":"حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ","translation":"jusqu'à ce que vous visitiez les tombes.","juz":30,"page":600,"surahName":"At-Takaathur","surahNameAr":"سُورَةُ التَّكَاثُرِ"},{"id":6171,"surah":102,"ayah":3,"text":"كَلَّا سَوْفَ تَعْلَمُونَ","translation":"Mais non! Vous saurez bientôt!","juz":30,"page":600,"surahName":"At-Takaathur","surahNameAr":"سُورَةُ التَّكَاثُرِ"},{"id":6172,"surah":102,"ayah":4,"text":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ","translation":"(Encore une fois)! Vous saurez bientôt!","juz":30,"page":600,"surahName":"At-Takaathur","surahNameAr":"سُورَةُ التَّكَاثُرِ"},{"id":6173,"surah":102,"ayah":5,"text":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ","translation":"Sûrement! Si vous saviez de science certaine.","juz":30,"page":600,"surahName":"At-Takaathur","surahNameAr":"سُورَةُ التَّكَاثُرِ"},{"id":6174,"surah":102,"ayah":6,"text":"لَتَرَوُنَّ ٱلْجَحِيمَ","translation":"Vous verrez, certes, la Fournaise.","juz":30,"page":600,"surahName":"At-Takaathur","surahNameAr":"سُورَةُ التَّكَاثُرِ"},{"id":6175,"surah":102,"ayah":7,"text":"ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ","translation":"Puis, vous la verrez certes, avec l'œil de la certitude.","juz":30,"page":600,"surahName":"At-Takaathur","surahNameAr":"سُورَةُ التَّكَاثُرِ"},{"id":6176,"surah":102,"ayah":8,"text":"ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ","translation":"Puis, assurément, vous serez interrogés, ce jour-là, sur les délices.","juz":30,"page":600,"surahName":"At-Takaathur","surahNameAr":"سُورَةُ التَّكَاثُرِ"}]