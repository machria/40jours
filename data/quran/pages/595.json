[{"id":6044,"surah":91,"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلشَّمْسِ وَضُحَىٰهَا","translation":"Par le soleil et par sa clarté!","juz":30,"page":595,"surahName":"Ash-Shams","surahNameAr":"سُورَةُ الشَّمۡسِ"},{"id":6045,"surah":91,"ayah":2,"text":"وَٱلْقَمَرِ إِذَا تَلَىٰهَا","translation":"Et par la lune quand elle le suit!","juz":30,"page":595,"surahName":"Ash-Shams","surahNameAr":"سُورَةُ الشَّمۡسِ"},{"id":6046,"surah":91,"ayah":3,"text":"وَٱلنَّهَارِ إِذَا جَلَّىٰهَا","translation":"Et par le jour quand il l'éclaire!","juz":30,"page":595,"surahName":"Ash-Shams","surahNameAr":"سُورَةُ الشَّمۡسِ"},{"id":6047,"surah":91,"ayah":4,"text":"وَٱلَّيْلِ إِذَا يَغْشَىٰهَا","translation":"Et par la nuit quand elle l'enveloppe!","juz":30,"page":595,"surahName":"Ash-Shams","surahNameAr":"سُورَةُ الشَّمۡسِ"},{"id":6048,"surah":91,"ayah":5,"text":"وَٱلسَّمَآءِ وَمَا بَنَىٰهَا","translation":"Et par le ciel et Celui qui l'a construit!","juz":30,"page":595,"surahName":"Ash-Shams","surahNameAr":"سُورَةُ الشَّمۡسِ"},{"id":6049,"surah":91,"ayah":6,"text":"وَٱلْأَرْضِ وَمَا طَحَىٰهَا","translation":"Et par la terre et Celui qui l'a étendue!","juz":30,"page":595,"surahName":"Ash-Shams","surahNameAr":"سُورَةُ الشَّمۡسِ"},{"id":6050,"surah":91,"ayah":7,"text":"وَنَفْسٍۢ وَمَا سَوَّىٰهَا","translation":"Et par l'âme et Celui qui l'a harmonieusement façonnée;","juz":30,"page":595,"surahName":"Ash-Shams","surahNameAr":"سُورَةُ الشَّمۡسِ"},{"id":6051,"surah":91,"ayah":8,"text":"فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا","translation":"et lui a alors inspiré son immoralité, de même que sa piété!","juz":30,"page":595,"surahName":"Ash-Shams","surahNameAr":"سُورَةُ الشَّمۡسِ"},{"id":6052,"surah":91,"ayah":9,"text":"قَدْ أَفْلَحَ مَن زَكَّىٰهَا","translation":"A réussi, certes, celui qui la purifie.","juz":30,"page":595,"surahName":"Ash-Shams","surahNameAr":"سُورَةُ الشَّمۡسِ"},{"id":6053,"surah":91,"ayah":10,"text":"وَقَدْ خَابَ مَن دَسَّىٰهَا","translation":"Et est perdu, certes, celui qui la corrompt.","juz":30,"page":595,"surahName":"Ash-Shams","surahNameAr":"سُورَةُ الشَّمۡسِ"},{"id":6054,"surah":91,"ayah":11,"text":"كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ","translation":"Les Thamûd, par leur transgression, ont crié au mensonge,","juz":30,"page":595,"surahName":"Ash-Shams","surahNameAr":"سُورَةُ الشَّمۡسِ"},{"id":6055,"surah":91,"ayah":12,"text":"إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا","translation":"lorsque le plus misérable d'entre eux se leva (pour tuer la chamelle)","juz":30,"page":595,"surahName":"Ash-Shams","surahNameAr":"سُورَةُ الشَّمۡسِ"},{"id":6056,"surah":91,"ayah":13,"text":"فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَٰهَا","translation":"Le Messager d'Allah leur avait dit: «La chamelle d'Allah! Laissez-la boire.","juz":30,"page":595,"surahName":"Ash-Shams","surahNameAr":"سُورَةُ الشَّمۡسِ"},{"id":6057,"surah":91,"ayah":14,"text":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا","translation":"Mais, ils le traitèrent de menteur, et la tuèrent. Leur Seigneur les détruisit donc, pour leur péché et étendit Son châtiment sur tous.","juz":30,"page":595,"surahName":"Ash-Shams","surahNameAr":"سُورَةُ الشَّمۡسِ"},{"id":6058,"surah":91,"ayah":15,"text":"وَلَا يَخَافُ عُقْبَٰهَا","translation":"Et Allah n'a aucune crainte des conséquences.","juz":30,"page":595,"surahName":"Ash-Shams","surahNameAr":"سُورَةُ الشَّمۡسِ"},{"id":6059,"surah":92,"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلَّيْلِ إِذَا يَغْشَىٰ","translation":"Par la nuit quand elle enveloppe tout!","juz":30,"page":595,"surahName":"Al-Lail","surahNameAr":"سُورَةُ اللَّيۡلِ"},{"id":6060,"surah":92,"ayah":2,"text":"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ","translation":"Par le jour quand il éclaire!","juz":30,"page":595,"surahName":"Al-Lail","surahNameAr":"سُورَةُ اللَّيۡلِ"},{"id":6061,"surah":92,"ayah":3,"text":"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ","translation":"Et par ce qu'Il a créé, mâle et femelle!","juz":30,"page":595,"surahName":"Al-Lail","surahNameAr":"سُورَةُ اللَّيۡلِ"},{"id":6062,"surah":92,"ayah":4,"text":"إِنَّ سَعْيَكُمْ لَشَتَّىٰ","translation":"Vos efforts sont divergents.","juz":30,"page":595,"surahName":"Al-Lail","surahNameAr":"سُورَةُ اللَّيۡلِ"},{"id":6063,"surah":92,"ayah":5,"text":"فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ","translation":"Celui qui donne et craint (Allah)","juz":30,"page":595,"surahName":"Al-Lail","surahNameAr":"سُورَةُ اللَّيۡلِ"},{"id":6064,"surah":92,"ayah":6,"text":"وَصَدَّقَ بِٱلْحُسْنَىٰ","translation":"et déclare véridique la plus belle récompense","juz":30,"page":595,"surahName":"Al-Lail","surahNameAr":"سُورَةُ اللَّيۡلِ"},{"id":6065,"surah":92,"ayah":7,"text":"فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ","translation":"Nous lui faciliterons la voie au plus grand bonheur.","juz":30,"page":595,"surahName":"Al-Lail","surahNameAr":"سُورَةُ اللَّيۡلِ"},{"id":6066,"surah":92,"ayah":8,"text":"وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ","translation":"Et quant à celui qui est avare, se dispense (de l'adoration d'Allah),","juz":30,"page":595,"surahName":"Al-Lail","surahNameAr":"سُورَةُ اللَّيۡلِ"},{"id":6067,"surah":92,"ayah":9,"text":"وَكَذَّبَ بِٱلْحُسْنَىٰ","translation":"et traite de mensonge la plus belle récompense,","juz":30,"page":595,"surahName":"Al-Lail","surahNameAr":"سُورَةُ اللَّيۡلِ"},{"id":6068,"surah":92,"ayah":10,"text":"فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ","translation":"Nous lui faciliterons la voie à la plus grande difficulté,","juz":30,"page":595,"surahName":"Al-Lail","surahNameAr":"سُورَةُ اللَّيۡلِ"},{"id":6069,"surah":92,"ayah":11,"text":"وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ","translation":"et à rien ne lui serviront ses richesses quand il sera jeté (au Feu).","juz":30,"page":595,"surahName":"Al-Lail","surahNameAr":"سُورَةُ اللَّيۡلِ"},{"id":6070,"surah":92,"ayah":12,"text":"إِنَّ عَلَيْنَا لَلْهُدَىٰ","translation":"C'est à Nous, certes, de guider;","juz":30,"page":595,"surahName":"Al-Lail","surahNameAr":"سُورَةُ اللَّيۡلِ"},{"id":6071,"surah":92,"ayah":13,"text":"وَإِنَّ لَنَا لَلْءَاخِرَةَ وَٱلْأُولَىٰ","translation":"à Nous appartient, certes, la vie dernière et la vie présente.","juz":30,"page":595,"surahName":"Al-Lail","surahNameAr":"سُورَةُ اللَّيۡلِ"},{"id":6072,"surah":92,"ayah":14,"text":"فَأَنذَرْتُكُمْ نَارًۭا تَلَظَّىٰ","translation":"Je vous ai donc avertis d'un Feu qui flambe","juz":30,"page":595,"surahName":"Al-Lail","surahNameAr":"سُورَةُ اللَّيۡلِ"}]