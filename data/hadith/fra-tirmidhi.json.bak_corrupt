                    "name": "Ahmad Muhammad Shakir",
                    "grade": "Sahih"
                },
                {
                    "name": "Al-Albani",
                    "grade": "Sahih"
                },
                {
                    "name": "Bashar Awad Maarouf",
                    "grade": "Hasan Sahih"
                },
